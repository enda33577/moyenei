/* ── Calendario de calor mensual ── */
function CalendarioMeta({diasDelMes,mes,metaDia,nombreMes,colorMeta}){
  const[tooltip,setTooltip]=React.useState(null);
  var DIAS_SEM=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  // Find what day of week the 1st falls on
  var parts=mes.split('-');
  var primerDia=new Date(Number(parts[0]),Number(parts[1])-1,1).getDay(); // 0=Dom
  // Build grid: pad with nulls at start
  var celdas=[];
  for(var i=0;i<primerDia;i++)celdas.push(null);
  diasDelMes.forEach(function(d){celdas.push(d);});
  // Pad to complete last row
  while(celdas.length%7!==0)celdas.push(null);

  return(
    <Card>
      <STitle icon="🗓️">{'Temperatura del mes — '+nombreMes}</STitle>
      {/* Header días semana */}
      <div style={{display:'grid',gridTemplateColumns:'repeat(7,28px)',gap:4,marginBottom:4}}>
        {['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'].map(function(d){return(
          <div key={d} style={{textAlign:'center',fontSize:10,fontWeight:700,color:'#9ca3af',padding:'2px 0'}}>{d}</div>
        );})}
      </div>
      {/* Grid de días */}
      <div style={{display:'grid',gridTemplateColumns:'repeat(7,28px)',gap:4,marginBottom:12}}>
        {celdas.map(function(d,i){
          if(!d)return <div key={'e'+i}/>;
          var pct=d.cierre&&metaDia>0?Number(d.cierre.TotalVenta||0)/metaDia:0;
          var bg=d.cierre?colorMeta(pct):'#f3f4f6';
          var isFuture=String(d.fecha).slice(0,10)>todayStr;
          var isToday=String(d.fecha).slice(0,10)===todayStr;
          var textColor=d.cierre&&pct>=0.5?'#fff':(d.cierre?'#374151':'#9ca3af');
          return(
            <div key={d.dia}
              onMouseEnter={function(){
                if(d.cierre){
                  setTooltip({
                    dia:d.dia,
                    fecha:fDate(d.fecha),
                    venta:fMXN(Number(d.cierre.TotalVenta||0)),
                    pct:metaDia>0?Math.round(pct*100):null,
                    recep:d.cierre.Recepcionista||'—',
                  });
                }
              }}
              onMouseLeave={function(){setTooltip(null);}}
              style={{
                width:28,height:28,
                borderRadius:'50%',
                background:isFuture?'#fafafa':bg,
                border:isToday?'2px solid #656b9c':'1px solid '+(d.cierre?bg:'#e5e7eb'),
                display:'flex',alignItems:'center',justifyContent:'center',
                fontSize:10,fontWeight:isToday?800:600,
                color:isToday&&!d.cierre?'#656b9c':textColor,
                cursor:d.cierre?'pointer':'default',
                opacity:isFuture?0.3:1,
              }}>
              {d.dia}
            </div>
          );
        })}
      </div>
      {/* Tooltip */}
      {tooltip&&(
        <div style={{background:'#1e1e2e',color:'#fff',borderRadius:8,padding:'10px 14px',
          fontSize:12,marginBottom:12,display:'flex',gap:16,flexWrap:'wrap',alignItems:'center'}}>
          <span style={{fontWeight:700}}>📅 {tooltip.fecha}</span>
          <span>💰 {tooltip.venta}</span>
          {tooltip.pct!==null&&<span style={{color:tooltip.pct>=100?'#4ade80':tooltip.pct>=80?'#fbbf24':'#f87171'}}>{tooltip.pct}% de meta</span>}
          <span style={{color:'#94a3b8'}}>👤 {tooltip.recep}</span>
        </div>
      )}
      {/* Leyenda */}
      <div style={{display:'flex',gap:12,flexWrap:'wrap',alignItems:'center'}}>
        {[['#16a34a','≥100%'],['#5b8a6e','≥80%'],['#d97706','≥60%'],['#ea580c','≥40%'],['#dc2626','<40%'],['#f3f4f6','Sin corte']].map(function(item){return(
          <div key={item[1]} style={{display:'flex',alignItems:'center',gap:4}}>
            <div style={{width:10,height:10,borderRadius:'50%',background:item[0],border:'1px solid #e5e7eb'}}/>
            <span style={{fontSize:10,color:'#6b7280'}}>{item[1]}</span>
          </div>
        );})}
      </div>
    </Card>
  );
}

function CajeraResumen({data,personal=[],metaDia=7000,notas=[],setNotas}){
  if(!data) return <div style={{textAlign:'center',padding:60,color:'#6b7280'}}>⌛ Cargando datos…</div>;

  const[mes,setMes]=useState(function(){
    var n=new Date();
    return n.getFullYear()+'-'+String(n.getMonth()+1).padStart(2,'0');
  });

  const cierres=(data.cierres||[]).slice().sort(function(a,b){return String(b.Fecha).slice(0,10).localeCompare(String(a.Fecha).slice(0,10));});
  const cierresMes=useMemo(function(){return cierres.filter(function(c){return c.Fecha&&String(c.Fecha).slice(0,7)===mes;});},[cierres,mes]);

  const mesesDisp=useMemo(function(){
    var set=new Set(cierres.map(function(c){return c.Fecha?c.Fecha.slice(0,7):'';}).filter(Boolean));
    var arr=[...set].sort(function(a,b){return b.localeCompare(a);});
    var actual=new Date().getFullYear()+'-'+String(new Date().getMonth()+1).padStart(2,'0');
    if(!set.has(actual))arr.unshift(actual);
    return arr;
  },[cierres]);

  const diasReg   = cierresMes.length;
  const totVenta  = cierresMes.reduce(function(s,c){return s+Number(c.TotalVenta||0);},0);
  const promDia   = diasReg>0?totVenta/diasReg:0;
  const totSalida = cierresMes.reduce(function(s,c){return s+Number(c.SalidaMonto||0);},0);
  const totCom    = cierresMes.reduce(function(s,c){return s+Number(c.Comision||0);},0);

  // Comisiones por recepcionista del mes
  const comPorRecep=useMemo(function(){
    var map={};
    cierresMes.forEach(function(c){
      var r=c.Recepcionista||'Sin nombre';
      if(!map[r])map[r]={nombre:r,dias:0,venta:0,comision:0};
      map[r].dias++;
      map[r].venta+=Number(c.TotalVenta||0);
      map[r].comision+=Number(c.Comision||0);
    });
    return Object.values(map).sort(function(a,b){return b.comision-a.comision;});
  },[cierresMes]);

  // Nombre del mes
  const nombreMes=useMemo(function(){
    var parts=mes.split('-');
    var d=new Date(Number(parts[0]),Number(parts[1])-1,1);
    var lbl=d.toLocaleDateString('es-MX',{month:'long',year:'numeric'});
    return lbl.charAt(0).toUpperCase()+lbl.slice(1);
  },[mes]);

  // Día anterior
  const ayer=cierres[0];
  const ayerPct=ayer&&metaDia>0?Number(ayer.TotalVenta||0)/metaDia:0;

  // Días del mes para la gráfica de puntos
  const diasDelMes=useMemo(function(){
    var parts=mes.split('-');
    var y=Number(parts[0]),m=Number(parts[1]);
    var totalDias=new Date(y,m,0).getDate();
    var dias=[];
    for(var d=1;d<=totalDias;d++){
      var fecha=y+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0');
      var cierre=cierresMes.find(function(c){return String(c.Fecha||'').slice(0,10)===fecha;});
      dias.push({dia:d,fecha:fecha,cierre:cierre||null});
    }
    return dias;
  },[mes,cierresMes]);

  // Color según % de meta
  function colorMeta(pct){
    if(!pct)return'#e5e7eb';
    if(pct>=1)return'#16a34a';
    if(pct>=0.8)return'#5b8a6e';
    if(pct>=0.6)return'#d97706';
    if(pct>=0.4)return'#ea580c';
    return'#dc2626';
  }

  var selS={padding:'7px 14px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,background:'#fff',fontWeight:600};
  var esHoy=cierres[0]&&cierres[0].Fecha===todayStr;

  return(
    <div style={{display:'flex',flexDirection:'column',gap:16}}>

      <Pizarron notas={notas} setNotas={setNotas} canEdit={true} autor={cierres[0]&&cierres[0].Recepcionista?cierres[0].Recepcionista:'Recepción'}/>

      {/* Selector de mes */}
      <Card style={{padding:'12px 18px'}}>
        <div style={{display:'flex',alignItems:'center',gap:12,flexWrap:'wrap'}}>
          <span style={{fontSize:14,fontWeight:700,color:'#374151'}}>📅 Mes:</span>
          <select value={mes} onChange={function(e){setMes(e.target.value);}} style={selS}>
            {mesesDisp.map(function(m){
              var parts=m.split('-');
              var lbl=new Date(Number(parts[0]),Number(parts[1])-1,1).toLocaleDateString('es-MX',{month:'long',year:'numeric'});
              return <option key={m} value={m}>{lbl.charAt(0).toUpperCase()+lbl.slice(1)}</option>;
            })}
          </select>
          <span style={{fontSize:12,color:'#6b7280'}}>{diasReg} días con corte</span>
        </div>
      </Card>

      {/* Fondo de apertura */}
      <FondoAperturaCard cierres={data.cierres||[]}/>

      {/* Resultado del último corte */}
      {ayer&&(
        <Card style={{borderLeft:'4px solid '+(ayerPct>=1?'#16a34a':ayerPct>=0.8?'#d97706':'#dc2626'),padding:'14px 18px'}}>
          <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',flexWrap:'wrap',gap:10}}>
            <div>
              <div style={{fontSize:13,fontWeight:700,color:'#111827',marginBottom:3}}>
                📊 {ayer.Fecha===todayStr?'Corte de hoy':'Último corte'} — {fDate(ayer.Fecha)}
              </div>
              <div style={{fontSize:11,color:'#6b7280'}}>
                {ayer.Recepcionista||'—'} · Comisión: {fMXN(Number(ayer.Comision||0))}
              </div>
            </div>
            <div style={{textAlign:'right'}}>
              <div style={{fontSize:22,fontWeight:800,color:colorMeta(ayerPct)}}>{fMXN(Number(ayer.TotalVenta||0))}</div>
              {metaDia>0&&<div style={{fontSize:11,color:'#6b7280'}}>{Math.round(ayerPct*100)}% de la meta</div>}
            </div>
          </div>
        </Card>
      )}

      {diasReg===0?(
        <Card style={{background:'#fffbeb',border:'1px solid #d97706',padding:'24px',textAlign:'center'}}>
          <div style={{fontSize:32,marginBottom:8}}>📋</div>
          <div style={{fontSize:15,fontWeight:600,color:'#78350f'}}>Sin cortes en {nombreMes}</div>
        </Card>
      ):(
        <>
          {/* KPIs simplificados */}
          <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:12}}>
            <KPI icon="📊" label="Promedio Diario"   value={fMXN(promDia)}   sub={diasReg+' días registrados'}  accent="#656b9c" bg="#ecedf7"/>
            <KPI icon="🎯" label="Comisiones Recep." value={fMXN(totCom)}    sub="1.5% (días con venta ≥$5,000)"       accent="#16a34a" bg="#dcfce7"/>
            <KPI icon="💸" label="Salidas del Mes"   value={fMXN(totSalida)} sub="pagos autorizados recepción"  accent="#dc2626" bg="#fee2e2"/>
          </div>

          {/* Calendario de calor */}
          <CalendarioMeta diasDelMes={diasDelMes} mes={mes} metaDia={metaDia} nombreMes={nombreMes} colorMeta={colorMeta}/>

          {/* Comisiones por recepcionista */}
          {comPorRecep.length>0&&(
            <Card>
              <STitle icon="🎯">Comisiones Recepcionistas — {nombreMes}</STitle>
              <div style={{display:'flex',flexDirection:'column',gap:8}}>
                {comPorRecep.map(function(r,i){return(
                  <div key={r.nombre} style={{display:'flex',alignItems:'center',gap:14,
                    padding:'12px 16px',borderRadius:10,
                    background:i===0?'#f0fdf4':'#f8faff',
                    border:i===0?'1px solid #86efac':'1px solid '+B}}>
                    <div style={{width:32,height:32,borderRadius:'50%',
                      background:i===0?'#16a34a':'#8f93b5',
                      color:'#fff',display:'flex',alignItems:'center',justifyContent:'center',
                      fontSize:13,fontWeight:700,flexShrink:0}}>
                      {r.nombre.charAt(0).toUpperCase()}
                    </div>
                    <div style={{flex:1}}>
                      <div style={{fontSize:13,fontWeight:600,color:'#111827'}}>{r.nombre}</div>
                      <div style={{fontSize:11,color:'#6b7280',marginTop:2}}>{r.dias} días · {fMXN(r.venta)} en ventas · 1.5%</div>
                    </div>
                    <div style={{textAlign:'right'}}>
                      <div style={{fontSize:18,fontWeight:800,color:i===0?'#16a34a':'#374151'}}>{fMXN(r.comision)}</div>
