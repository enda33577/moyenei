/* ═══════════════════════════════════════════
   APP PRINCIPAL
═══════════════════════════════════════════ */
function App(){
  const[modulo,setModulo]=useState(null);
  const[passwords,setPasswords]=useState({cajera:'',tesorera:'',cajaMayor:'',solicitudes:''});
  const[configLoaded,setConfigLoaded]=useState(false);
  // Personal — se carga desde Sheets al iniciar
  const[personal,setPersonal]=useState([]);
  // Quincenas pagadas (para reiniciar conteo)
  const[quincenasPagadas,setQuincenasPagadas]=useState([]);
  const[metaDia,setMetaDia]=useState(7000);
  const[solicitudes,setSolicitudes]=useState([]);
  const[passSolicitudes,setPassSolicitudes]=useState('');
  // RH: asistencia y datos extra del personal
  // asistencia: { 'nombre_YYYY-MM-DD': 'tiempo'|'retardo'|'retardo_grave'|'falta' }
  const[asistencia,setAsistencia]=useState({});
  // rhData: extra profile data per person { nombre: {tarifa,tipoPago,horario,tel,pagadoHasta} }
  const[rhData,setRhData]=useState({});
  // Pizarrón compartido (postits)
  const[notas,setNotas]=useState([]);
  // Calendario de asuetos { 'YYYY-MM-DD': {tipo:'asueto'|'salida_temprana', descripcion:''} }
  const[asuetos,setAsuetos]=useState({});
  // Shared config state (used by Gerencia and Dirección)
  // Config — se carga desde Sheets al iniciar
  const[cuentas,setCuentas]=useState([]);
  const[cats,setCats]=useState([]);
  const[subcats,setSubcats]=useState([]);
  const[ubics,setUbics]=useState([]);

  // Cargar contraseñas desde Sheets al iniciar
  useEffect(()=>{
    api({action:'getAppState'}).then(function(state){
      if(!state||state.error){setConfigLoaded(true);return;}
      // Contraseñas
      var cfg=state.config||{};
      setPasswords({
        cajera:      String(cfg.pass_cajera      ||'').trim(),
        tesorera:    String(cfg.pass_tesorera    ||'').trim(),
        cajaMayor:   String(cfg.pass_cajaMayor   ||'').trim(),
        solicitudes: String(cfg.pass_solicitudes ||'').trim(),
      });
      if(cfg.pass_solicitudes)setPassSolicitudes(String(cfg.pass_solicitudes).trim());
      // Meta del día
      if(cfg.metaDia)setMetaDia(Number(cfg.metaDia)||7000);
      // Categorías, subcategorías, ubicaciones
      if(cfg.cats)    try{setCats(JSON.parse(cfg.cats));}catch(e){}
      if(cfg.subcats) try{setSubcats(JSON.parse(cfg.subcats));}catch(e){}
      if(cfg.ubics)   try{setUbics(JSON.parse(cfg.ubics));}catch(e){}
      if(cfg.cuentas) try{setCuentas(JSON.parse(cfg.cuentas));}catch(e){}
      // Personal
      if(state.personal&&state.personal.length>0)setPersonal(state.personal);
      // RH Perfiles → rhData
      if(state.rhPerfiles&&state.rhPerfiles.length>0){
        var rh={};
        state.rhPerfiles.forEach(function(p){
          rh[p.nombre]={
            tarifa:   Number(p.tarifa)||0,
            tipoPago: p.tipoPago||'dia',
            horario:  p.horario||'',
            tel:      p.tel||'',
            pagadoHasta: p.pagadoHasta||null,
            horarioEntrada:{Lun:p.horarioEntrada_Lun||'',Mar:p.horarioEntrada_Mar||'',Mié:p.horarioEntrada_Mie||'',Jue:p.horarioEntrada_Jue||'',Vie:p.horarioEntrada_Vie||'',Sáb:p.horarioEntrada_Sab||'',Dom:p.horarioEntrada_Dom||''},
            horarioSalida: {Lun:p.horarioSalida_Lun||'',Mar:p.horarioSalida_Mar||'',Mié:p.horarioSalida_Mie||'',Jue:p.horarioSalida_Jue||'',Vie:p.horarioSalida_Vie||'',Sáb:p.horarioSalida_Sab||'',Dom:p.horarioSalida_Dom||''},
          };
        });
        setRhData(rh);
      }
      // Asistencia
      if(state.asistencia&&Object.keys(state.asistencia).length>0)setAsistencia(state.asistencia);
      // Notas pizarrón
      if(state.notas&&state.notas.length>0)setNotas(state.notas);
      // Asuetos
      if(state.asuetos&&Object.keys(state.asuetos).length>0)setAsuetos(state.asuetos);
      setConfigLoaded(true);
    }).catch(function(){setConfigLoaded(true);});
  },[]);


  // ── Auto-save a Sheets cuando cambian los estados ──
  const isLoaded=React.useRef(false);
  useEffect(()=>{if(configLoaded)isLoaded.current=true;},[configLoaded]);

  useEffect(()=>{if(!isLoaded.current)return;api({action:'setPersonal',data:JSON.stringify(personal)}).catch(()=>{});},[personal]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setConfig',clave:'metaDia',valor:metaDia}).catch(()=>{});},[metaDia]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setConfig',clave:'cats',valor:JSON.stringify(cats)}).catch(()=>{});},[cats]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setConfig',clave:'subcats',valor:JSON.stringify(subcats)}).catch(()=>{});},[subcats]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setConfig',clave:'ubics',valor:JSON.stringify(ubics)}).catch(()=>{});},[ubics]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setConfig',clave:'cuentas',valor:JSON.stringify(cuentas)}).catch(()=>{});},[cuentas]);
  useEffect(()=>{if(!isLoaded.current)return;api({action:'setNotas',data:JSON.stringify(notas)}).catch(()=>{});},[notas]);

  if(!modulo)return <LoginScreen onLogin={setModulo} passwords={passwords} configLoaded={configLoaded}/>;

  return(
    <>
      
      {modulo==='recepcion' &&<ModuloCajera     onLogout={()=>setModulo(null)} personal={personal} metaDia={metaDia} notas={notas} setNotas={setNotas}/>}
      {modulo==='gerencia'  &&<ModuloTesorera   onLogout={()=>setModulo(null)} personal={personal} quincenasPagadas={quincenasPagadas} setQuincenasPagadas={setQuincenasPagadas} cuentas={cuentas} setCuentas={setCuentas} cats={cats} setCats={setCats} subcats={subcats} setSubcats={setSubcats} ubics={ubics} setUbics={setUbics} solicitudes={solicitudes} setSolicitudes={setSolicitudes} asistencia={asistencia} setAsistencia={setAsistencia} rhData={rhData} setRhData={setRhData} notas={notas} setNotas={setNotas} asuetos={asuetos} setAsuetos={setAsuetos}/>}
      {modulo==='solicitudes'&&<ModuloSolicitudes onLogout={()=>setModulo(null)} personal={personal} inv={[]} solicitudes={solicitudes} setSolicitudes={setSolicitudes} asuetos={asuetos} notas={notas} setNotas={setNotas}/>}
      {modulo==='direccion' &&<ModuloCajaMayor  onLogout={()=>setModulo(null)} personal={personal} setPersonal={setPersonal} quincenasPagadas={quincenasPagadas} setQuincenasPagadas={setQuincenasPagadas} cuentas={cuentas} setCuentas={setCuentas} cats={cats} setCats={setCats} subcats={subcats} setSubcats={setSubcats} ubics={ubics} setUbics={setUbics} passwords={passwords} metaDia={metaDia} setMetaDia={setMetaDia} passSolicitudes={passSolicitudes} setPassSolicitudes={setPassSolicitudes} rhData={rhData} asistencia={asistencia}/>}
    </>
  );
}


/* ═══════════════════════════════════════════
   MÓDULO SOLICITUDES (acceso equipo)
