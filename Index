      )}
    </div>
  );
}

/* ── Historial ── */
function CajeraHistorial({data}){
  const cierres=(data?.cierres||[]).sort((a,b)=>b.Fecha.localeCompare(a.Fecha));
  return(
    <Card style={{padding:0,overflow:'hidden'}}>
      <div style={{padding:'14px 18px',borderBottom:`1px solid ${B}`,fontSize:14,fontWeight:700}}>
        📋 Historial de Cortes
      </div>
      <div style={{overflowX:'auto'}}>
        <table style={{width:'100%',borderCollapse:'collapse',fontSize:12}}>
          <thead><tr>
            {['Fecha','Recepcionista','Efectivo','Tarjeta','Transf.','Total Venta','Comisión','Salida','Queda Caja','→ CF','→ SPIN Tes.'].map(h=>(
              <th key={h} style={{padding:'9px 10px',fontSize:11,fontWeight:700,color:'#fff',
                background:'#5b8a6e',textAlign:'left',whiteSpace:'nowrap'}}>{h}</th>
            ))}
          </tr></thead>
          <tbody>
            {cierres.map((c,i)=>(
              <tr key={i} style={{background:i%2?'#f0fdf4':'#fff',borderTop:`1px solid ${B}`}}>
                <td style={{padding:'8px 10px',whiteSpace:'nowrap',fontWeight:String(c.Fecha).slice(0,10)===todayStr?700:400,color:String(c.Fecha).slice(0,10)===todayStr?'#5b8a6e':'#374151'}}>{fDate(c.Fecha)}</td>
                <td style={{padding:'8px 10px'}}>{c.Recepcionista}</td>
                <td style={{padding:'8px 10px',textAlign:'right'}}>{fMXN(c.Efectivo||c.efectivo||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right'}}>{fMXN(c.Tarjeta||c.tarjeta||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right'}}>{fMXN(c.Transferencia||c.transferencia||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right',fontWeight:700,color:'#5b8a6e'}}>{fMXN(c.TotalVenta||c.totalVenta||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right',fontWeight:600,color:'#16a34a'}}>{fMXN(c.Comision||c.comision||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right',color:Number(c.SalidaMonto)>0?'#dc2626':'#9ca3af'}}>
                  {Number(c.SalidaMonto)>0?fMXN(c.SalidaMonto):'—'}
                  {c.SalidaConcepto&&<div style={{fontSize:10,color:'#6b7280'}}>{c.SalidaConcepto}</div>}
                </td>
                <td style={{padding:'8px 10px',textAlign:'right'}}>{fMXN(c.QuedaEnCaja||c.quedaEnCaja||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right',fontWeight:700,color:'#656b9c'}}>{fMXN(c.VaACajaFuerte||c.vaACajaFuerte||0)}</td>
                <td style={{padding:'8px 10px',textAlign:'right',fontWeight:700,color:'#0369a1'}}>{fMXN(c.SpinPendiente||c.spinPendiente||0)}</td>
              </tr>
            ))}
            {cierres.length===0&&(
              <tr><td colSpan={11} style={{padding:40,textAlign:'center',color:'#9ca3af'}}>Sin cortes registrados</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </Card>
  );
}

/* ═══════════════════════════════════════════
   MÓDULO TESORERA
═══════════════════════════════════════════ */
function ModuloTesorera({onLogout,personal=[],quincenasPagadas=[],setQuincenasPagadas,cuentas=[],setCuentas,cats=[],setCats,subcats=[],setSubcats,ubics=[],setUbics,solicitudes=[],setSolicitudes,asistencia={},setAsistencia,rhData={},setRhData,notas=[],setNotas,asuetos={},setAsuetos}){
  const[view,setView]=useState('dashboard');
  const[data,setData]=useState(null);
  const[inv,setInv]=useState([]);
  const[movInv,setMovInv]=useState([]);
  const[loading,setLoading]=useState(false);
  const[toast,setToast]=useState(null);
  const[updated,setUpdated]=useState(new Date());
  function notify(msg,type='info'){setToast({message:msg,type});setTimeout(()=>setToast(null),4500);}

  const load=useCallback(async()=>{
    setLoading(true);
    try{
      const[d,di]=await Promise.all([
        api({action:'getTesoreria'}),
        api({action:'getInventario'})
      ]);
      setData(d);
      setInv(di.productos||[]);
      setMovInv(di.movimientos||[]);
      setUpdated(new Date());
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  },[]);
  useEffect(()=>{load();},[]);

  const pendientes=solicitudes.filter(function(s){return s.estado==='pendiente';}).length;
  const NAV=[
    {id:'dashboard',   icon:'📊', label:'Dashboard'},
    {id:'solicitudes', icon:'📬', label:'Solicitudes', badge:pendientes},
    {id:'almacen',     icon:'🏪', label:'Almacén'},
    {id:'piso',        icon:'🏬', label:'Piso'},
    {id:'transferir',  icon:'🔄', label:'Almacén → Piso'},
    {id:'nuevo',       icon:'➕', label:'Nuevo Producto'},
    {id:'gasto',       icon:'🔽', label:'Registrar Gasto'},
    {id:'recepcion',   icon:'🧾', label:'Último Cierre'},
    {id:'comisiones',  icon:'🎯', label:'Comisiones'},
    {id:'rh',          icon:'👥', label:'Recursos Humanos'},
    {id:'historial',   icon:'📋', label:'Historial'},
  ];

  async function handleSalida(form){
    setLoading(true);
    try{
      await api({action:'registrarSalidaTes',
        concepto:form.concepto, monto:form.monto,
        cuenta:form.cuenta, categoria:form.categoria,
        subcategoria:form.subcategoria,
        responsable:form.responsable, notas:form.notas||''
      });
      if(form.registraInventario&&form.productoId){
        await api({action:'entradaInventario',
          id:form.productoId,
          cantAlmacen:form.cantAlmacen||0,
          cantPiso:form.cantPiso||0,
          costo:form.monto,
          responsable:form.responsable,
          notas:form.concepto
        });
      }
      const[d,di]=await Promise.all([api({action:'getTesoreria'}),api({action:'getInventario'})]);
      setData(d);setInv(di.productos||[]);setMovInv(di.movimientos||[]);
      setUpdated(new Date());
      notify('Gasto registrado correctamente','success');
      setView('dashboard');
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  }

  async function handleNuevoProducto(prod){
    setLoading(true);
    try{
      const di=await api({action:'agregarProductoV2',...prod});
      setInv(di.productos||[]);setMovInv(di.movimientos||[]);
      setUpdated(new Date());
      notify(`"${prod.nombre}" agregado al inventario`,'success');
      setView('almacen');
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  }

  async function handleTransferir(id,nombre,cant){
    setLoading(true);
    try{
      const di=await api({action:'transferirAPiso',id,cantidad:cant});
      setInv(di.productos||[]);setMovInv(di.movimientos||[]);
      setUpdated(new Date());
      notify(`${cant} uds. de "${nombre}" transferidas a Piso`,'success');
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  }

  async function handleSalidaPiso(id,nombre,cant,motivo){
    setLoading(true);
    try{
      const di=await api({action:'salidaPiso',id,cantidad:cant,motivo});
      setInv(di.productos||[]);setMovInv(di.movimientos||[]);
      setUpdated(new Date());
      notify(`Salida de ${cant} uds. de "${nombre}" registrada`,'success');
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  }

  function cerrarQuincena(){
    setQuincenasPagadas(prev=>[...prev,{fecha:localDateStr(),ts:Date.now()}]);
    notify('Quincena cerrada — comisiones reiniciadas','success');
  }

  return(<>
    <Shell modulo="gerencia" onLogout={onLogout} nav={NAV} activeView={view} setView={setView} updated={updated} onRefresh={load} loading={loading}>
      {view==='dashboard'  &&<GerenciaDashboard data={data} inv={inv} notas={notas} setNotas={setNotas}/>}
      {view==='solicitudes' &&<GerenciaSolicitudes solicitudes={solicitudes} setSolicitudes={setSolicitudes} inv={inv} onTransferir={handleTransferir}/>}
      {view==='almacen'    &&<InvAlmacen inv={inv} onTransferir={handleTransferir}/>}
      {view==='piso'       &&<InvPiso inv={inv} onSalida={handleSalidaPiso}/>}
      {view==='transferir' &&<InvTransferir inv={inv} onTransferir={handleTransferir} loading={loading}/>}
      {view==='nuevo'      &&<InvNuevo onAdd={handleNuevoProducto} loading={loading} cats={cats} subcats={subcats} ubics={ubics}/>}
      {view==='gasto'      &&<TesoreraGasto onSave={handleSalida} loading={loading} data={data} inv={inv} personal={personal} cats={cats} subcats={subcats}/>}
      {view==='recepcion'  &&<TesoreraVistaCAjera data={data}/>}
      {view==='comisiones' &&<TesoreraComisiones data={data} personal={personal} quincenasPagadas={quincenasPagadas} onCerrar={cerrarQuincena}/>}
      {view==='rh'          &&<RHModule personal={personal} asistencia={asistencia} setAsistencia={setAsistencia} rhData={rhData} setRhData={setRhData} quincenasPagadas={quincenasPagadas} asuetos={asuetos} setAsuetos={setAsuetos}/>}
      {view==='historial'  &&<TesoreraHistorial data={data}/>}
    </Shell>
    <Toast t={toast} close={()=>setToast(null)}/>
  </>);
}


/* ═══════════════════════════════════════════
   INVENTARIO DOBLE NIVEL
═══════════════════════════════════════════ */
const CATS_DOBLE=['Mercancía','Insumos de trabajo','Insumos internos','Mobiliario y equipo'];
const UNIDADES_INV=['Caja','Gramo','Kg','Litro','Paquete','Par','Pieza','Resma','Rollo','Unidad'];
function tieneDobleNivel(cat){return CATS_DOBLE.includes(cat);}
function getEstadoNivel(cant,min){
  const q=Number(cant)||0,mn=Number(min)||0;
  if(q===0)return{label:'Sin stock',dot:'⛔',bg:'#fecaca',color:'#7f1d1d',border:'#b91c1c'};
  if(mn>0&&q<mn)return{label:'Crítico',dot:'🔴',bg:'#fee2e2',color:'#7f1d1d',border:'#dc2626'};
  if(mn>0&&q<mn*1.5)return{label:'Bajo',dot:'🟡',bg:'#fef9c3',color:'#713f12',border:'#ca8a04'};
  return{label:'OK',dot:'🟢',bg:'#dcfce7',color:'#14532d',border:'#16a34a'};
}

function InvKPIs({inv}){
  if(!inv.length)return null;
  const conDoble=inv.filter(function(p){return tieneDobleNivel(p.categoria);});
  const sinStock=conDoble.filter(function(p){return Number(p.stockPiso)===0;}).length;
  const criticos=conDoble.filter(function(p){return getEstadoNivel(p.stockPiso,p.minPiso).label==='Crítico';}).length;
  return(
    <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:12}}>
      <KPI icon="📦" label="Productos"       value={inv.length}     sub="en catálogo"           accent="#656b9c"/>
      <KPI icon="🏪" label="Con doble nivel" value={conDoble.length} sub="Almacén + Piso"        accent="#b07d4a"/>
      <KPI icon="⛔" label="Sin stock Piso"  value={sinStock}        sub="requieren reposición"  accent="#dc2626" bg="#fee2e2"/>
      <KPI icon="🔴" label="Críticos Piso"   value={criticos}        sub="bajo mínimo"           accent="#ea580c" bg="#fff7ed"/>
    </div>
  );
}

function GerenciaDashboard({data,inv,notas=[],setNotas}){
  if(!data&&!inv.length)return <div style={{textAlign:'center',padding:60,color:'#6b7280'}}>⌛ Cargando…</div>;
  const r=data?data.resumen:{};
  const cierres=data?data.cierres:[];
  const ultimo=cierres.length>0?cierres[cierres.length-1]:null;
  const fondoCaja=ultimo?Number(ultimo.QuedaEnCaja)||0:0;
  const cf=Number(r.saldoCajaFuerte)||0;
  const spin=Number(r.saldoSPIN)||0;
  const bbva=Number(r.saldoBBVA)||0;
  const saldoTotal=cf+spin+bbva+fondoCaja;
  const alertas=inv.filter(function(p){
    if(!tieneDobleNivel(p.categoria))return false;
    var ep=getEstadoNivel(p.stockPiso,p.minPiso);
    return ep.label==='Crítico'||ep.label==='Sin stock';
  });
  return(
    <div style={{display:'flex',flexDirection:'column',gap:18}}>
      {alertas.length>0&&(
        <Card style={{borderLeft:'4px solid #dc2626',padding:'14px 18px'}}>
          <div style={{fontSize:13,fontWeight:700,color:'#7f1d1d',marginBottom:10}}>⚠️ Alertas de Inventario ({alertas.length})</div>
          {alertas.map(function(p){
            var ep=getEstadoNivel(p.stockPiso,p.minPiso);
            return(
              <div key={p.id} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'7px 10px',borderRadius:7,background:'#fef2f2',border:'1px solid #fecaca',marginBottom:6}}>
                <span style={{fontSize:13,fontWeight:600}}>{p.nombre}</span>
                <div style={{display:'flex',gap:10,alignItems:'center'}}>
                  <span style={{fontSize:11,color:'#6b7280'}}>Piso: {p.stockPiso} / mín {p.minPiso}</span>
                  <span style={{padding:'2px 8px',borderRadius:9999,fontSize:11,fontWeight:700,background:ep.bg,color:ep.color}}>{ep.dot} {ep.label}</span>
                </div>
              </div>
            );
          })}
        </Card>
      )}
      <div style={{display:'grid',gridTemplateColumns:'repeat(5,1fr)',gap:12}}>
        <KPI icon="💵" label="Caja Registradora" value={fMXN(fondoCaja)} sub={ultimo?"Dejó "+String(ultimo.Recepcionista||"—")+" el "+fDate(ultimo.Fecha):"sin cortes"} accent="#5b8a6e" bg="#ccfbf1"/>
        <KPI icon="🏦" label="Caja Fuerte"        value={fMXN(cf)}       sub="efectivo acumulado"  accent="#656b9c" bg="#ecedf7"/>
        <KPI icon="📲" label="SPIN"               value={fMXN(spin)}     sub="transferencias"      accent="#0369a1" bg="#dbeafe"/>
        <KPI icon="💳" label="BBVA"               value={fMXN(bbva)}     sub="tarjetas"            accent="#7c6ab5" bg="#ede9fe"/>
        <div style={{background:'#3d4275',borderRadius:12,padding:'16px 18px',color:'#fff'}}>
          <div style={{fontSize:11,marginBottom:6,color:'#c7caeb',fontWeight:600}}>💰 TOTAL DISPONIBLE</div>
          <div style={{fontSize:24,fontWeight:800}}>{fMXN(saldoTotal)}</div>
          <div style={{fontSize:10,color:'#c7caeb',marginTop:4}}>suma de todas las cuentas</div>
        </div>
      </div>
      <Pizarron notas={notas} setNotas={setNotas} canEdit={true} autor='Gerencia'/>
      <InvKPIs inv={inv}/>
      {ultimo&&(
        <Card style={{borderLeft:'4px solid #5b8a6e'}}>
          <STitle icon="🧾">Último cierre Recepción — {fDate(ultimo.Fecha)}</STitle>
          <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:10}}>
            {[['Total venta',Number(ultimo.TotalVenta||0),'#5b8a6e'],['→ Caja Fuerte',Number(ultimo.VaACajaFuerte||0),'#656b9c'],['→ SPIN pendiente',Number(ultimo.SpinPendiente||0),'#0369a1'],['Queda en caja',Number(ultimo.QuedaEnCaja||0),'#b07d4a']].map(function(item){return(
              <div key={item[0]} style={{textAlign:'center',background:'#f8faff',borderRadius:8,padding:'10px 12px'}}>
                <div style={{fontSize:11,color:'#6b7280',marginBottom:3}}>{item[0]}</div>
                <div style={{fontSize:15,fontWeight:700,color:item[2]}}>{fMXN(item[1])}</div>
              </div>
            );})}
          </div>
        </Card>
      )}
    </div>
  );
}

function InvAlmacen({inv,onTransferir}){
  const[q,setQ]=useState('');
  const[fCat,setFCat]=useState('');
  const[fSub,setFSub]=useState('');
  const[fUbic,setFUbic]=useState('');
  const[tQ,setTQ]=useState({});
  // Unique filter options from inventory
  const cats=useMemo(function(){return[...new Set(inv.filter(function(p){return tieneDobleNivel(p.categoria);}).map(function(p){return p.categoria;}).filter(Boolean))].sort();},[inv]);
  const subs=useMemo(function(){return[...new Set(inv.filter(function(p){return tieneDobleNivel(p.categoria)&&(!fCat||p.categoria===fCat);}).map(function(p){return p.subcategoria;}).filter(Boolean))].sort();},[inv,fCat]);
