<script type="text/babel">
const{useState,useEffect,useMemo,useCallback,useRef}=React;

/* ═══════════════════════════════════════════
   CONFIGURACIÓN API
═══════════════════════════════════════════ */
const SCRIPT_URL='https://script.google.com/macros/s/AKfycbyY02YdYfyXJMzOSQql998CgxbrwSrJvxjP0zFbulfYWLBUmuWBg92VlBex7GKZUzqm/exec';

async function api(params={}){
  const u=new URL(SCRIPT_URL);
  Object.entries(params).forEach(([k,v])=>u.searchParams.set(k,String(v??'')));
  const r=await fetch(u.toString(),{redirect:'follow'});
  const d=await r.json();
  if(d.error)throw new Error(d.error);
  return d;
}

/* ═══════════════════════════════════════════
   CONSTANTES
═══════════════════════════════════════════ */
const NAVY='#656b9c'; const B='#dddde8';
const CHART_COLORS=['#2563eb','#0f766e','#d97706','#dc2626','#7c3aed','#0369a1','#b45309','#0e7490'];


const ESTADO_CFG={
  'OK':              {dot:'🟢',bg:'#dcfce7',color:'#14532d',border:'#16a34a'},
  'Bajo':            {dot:'🟡',bg:'#fef9c3',color:'#713f12',border:'#ca8a04'},
  'Crítico':         {dot:'🔴',bg:'#fee2e2',color:'#7f1d1d',border:'#dc2626'},
  'Sin stock':       {dot:'⛔',bg:'#fecaca',color:'#450a0a',border:'#b91c1c'},
  'Sobreinventario': {dot:'🔵',bg:'#ede9fe',color:'#3b0764',border:'#7c3aed'},
  'Caducado':        {dot:'💀',bg:'#fca5a5',color:'#450a0a',border:'#7f1d1d'},
  'Por caducar':     {dot:'⏰',bg:'#fed7aa',color:'#7c2d12',border:'#ea580c'},
};

const CUENTAS_TES=['Efectivo (Caja Fuerte)','SPIN','BBVA'];
const CAT_TES=['Inventario','Nómina','Servicios','Mantenimiento','Impuestos','Proveedores','Otro'];
const CAT_CM=['Impuestos','Deudas','Depreciaciones','Inversiones','Gastos extraordinarios','Otro'];
const FORMAS_PAGO=['Efectivo','Transferencia','Tarjeta de crédito','Tarjeta de débito','Cheque'];
const MOT_ENT=['Compra a proveedor','Devolución de área','Ajuste de inventario','Reposición periódica'];
const MOT_SAL=['Consumo diario','Entrega a área','Merma / daño','Préstamo temporal','Uso interno'];
const CATEGORIAS=[];
const UNIDADES=['Caja','Gramo','Kg','Litro','Paquete','Par','Pieza','Resma','Rollo','Unidad'];
const UBICACIONES=[];

/* ═══════════════════════════════════════════
   HELPERS
═══════════════════════════════════════════ */
function localDateStr(d){d=d||new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
const todayStr=localDateStr();
function dAgo(n){const d=new Date();d.setDate(d.getDate()-n);return localDateStr(d);}
function getEstado(item){
  const q=Number(item['Cantidad Actual']),mn=Number(item['Stock Mínimo']),mx=Number(item['Stock Máximo']),fc=item['Fecha Caducidad'];
  if(fc){const d=diasCad(fc);if(d!==null&&d<0)return'Caducado';if(d!==null&&d<=30)return'Por caducar';}
  if(q===0)return'Sin stock';if(mx>0&&q>mx)return'Sobreinventario';
  if(q>=mn)return'OK';if(q>=mn*.5)return'Bajo';return'Crítico';
}
function fDate(s){
  if(!s)return'—';
  var str=String(s).trim();
  // Already formatted or invalid
  if(!str||str==='—')return'—';
  // Normalize: take only first 10 chars (YYYY-MM-DD) in case there's time appended
  if(str.length>10)str=str.slice(0,10);
  // Parse parts directly to avoid timezone issues
  var parts=str.split('-');
  if(parts.length!==3)return str;
  var d=new Date(Number(parts[0]),Number(parts[1])-1,Number(parts[2]));
  if(isNaN(d.getTime()))return str;
  return d.toLocaleDateString('es-MX',{day:'2-digit',month:'short',year:'numeric'});
}
function fNow(d){return d.toLocaleString('es-MX',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});}
function fMXN(n){return(Number(n)||0).toLocaleString('es-MX',{style:'currency',currency:'MXN',minimumFractionDigits:2});}
function genID(inv){const nums=inv.map(i=>parseInt((i.ID||'').replace('INV-',''))||0);return'INV-'+String(Math.max(0,...nums)+1).padStart(3,'0');}

/* ═══════════════════════════════════════════
   CHART WRAPPER
═══════════════════════════════════════════ */
function CJChart({type,labels,datasets,options={},height=240}){
  const ref=useRef(null),inst=useRef(null);
  useEffect(()=>{
    if(!ref.current)return;
    if(inst.current){inst.current.destroy();inst.current=null;}
    inst.current=new Chart(ref.current,{type,data:{labels,datasets},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:datasets.length>1,labels:{font:{size:11}}},tooltip:{bodyFont:{size:12}}},...options}});
    return()=>{if(inst.current){inst.current.destroy();inst.current=null;}};
  },[JSON.stringify({type,labels,datasets})]);
  return <div style={{height,position:'relative'}}><canvas ref={ref}/></div>;
}

/* ═══════════════════════════════════════════
   UI PRIMITIVOS
═══════════════════════════════════════════ */
function Badge({estado}){const c=ESTADO_CFG[estado]||{dot:'⚪',bg:'#f3f4f6',color:'#374151',border:'#9ca3af'};return <span style={{display:'inline-flex',alignItems:'center',gap:4,padding:'2px 10px',borderRadius:9999,fontSize:11,fontWeight:700,border:`1px solid ${c.border}`,background:c.bg,color:c.color,whiteSpace:'nowrap'}}>{c.dot} {estado}</span>;}
function Card({children,style={}}){return <div style={{background:'#fff',borderRadius:12,padding:20,boxShadow:'0 2px 8px rgba(101,107,156,.1)',border:`1px solid ${B}`,...style}}>{children}</div>;}
function STitle({icon,children,right}){return <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:14}}><div style={{fontSize:14,fontWeight:700,color:'#111827',display:'flex',alignItems:'center',gap:8}}><span>{icon}</span>{children}</div>{right&&<div>{right}</div>}</div>;}
function KPI({icon,label,value,sub,accent,bg='#f1f5f9'}){return <div style={{background:'#fff',borderRadius:12,padding:'16px 18px',borderLeft:`4px solid ${accent}`,boxShadow:'0 1px 4px rgba(0,0,0,.07)',border:`1px solid ${B}`,borderLeftColor:accent}}><div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:6}}><span style={{fontSize:18}}>{icon}</span><span style={{fontSize:10,fontWeight:600,color:accent,background:bg,padding:'2px 8px',borderRadius:9999}}>{label}</span></div><div style={{fontSize:22,fontWeight:800,color:'#111827',lineHeight:1.1}}>{value}</div><div style={{fontSize:11,color:'#6b7280',marginTop:3}}>{sub}</div></div>;}
function Toast({t,close}){if(!t)return null;const m={success:{bg:'#f0fdf4',border:'#16a34a',text:'#14532d',i:'✅'},error:{bg:'#fef2f2',border:'#dc2626',text:'#7f1d1d',i:'❌'},warning:{bg:'#fffbeb',border:'#d97706',text:'#78350f',i:'⚠️'},info:{bg:'#eff6ff',border:'#2563eb',text:'#3d4275',i:'ℹ️'}};const c=m[t.type]||m.info;return <div style={{position:'fixed',top:20,right:20,zIndex:9999,background:c.bg,border:`1px solid ${c.border}`,borderRadius:10,padding:'14px 18px',boxShadow:'0 4px 16px rgba(0,0,0,.15)',display:'flex',alignItems:'center',gap:10,maxWidth:420,animation:'slideIn .3s ease'}}><span style={{fontSize:18}}>{c.i}</span><span style={{color:c.text,fontSize:13,fontWeight:500,flex:1}}>{t.message}</span><button onClick={close} style={{background:'none',border:'none',cursor:'pointer',color:c.text,fontSize:20,lineHeight:1,paddingLeft:8}}>×</button></div>;}

function Lbl({children,req}){return <label style={{fontSize:12,fontWeight:700,color:'#374151',marginBottom:4,display:'block'}}>{children}{req&&<span style={{color:'#dc2626',marginLeft:2}}>*</span>}</label>;}
function Err({msg}){return msg?<p style={{color:'#dc2626',fontSize:11,marginTop:4}}>{msg}</p>:null;}
function Inp({field,errs,...props}){return <input style={{padding:'9px 13px',borderRadius:8,fontSize:13,width:'100%',border:`1.5px solid ${errs&&errs[field]?'#dc2626':'#d1d5db'}`,background:'#fff',...(props.style||{})}} {...props}/>;}
function Sel({field,errs,children,...props}){return <select style={{padding:'9px 13px',borderRadius:8,fontSize:13,width:'100%',border:`1.5px solid ${errs&&errs[field]?'#dc2626':'#d1d5db'}`,background:'#fff'}} {...props}>{children}</select>;}
function Row2({children}){return <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:16,marginBottom:16}}>{children}</div>;}
function Col({children}){return <div>{children}</div>;}
function Btn({children,color='#656b9c',disabled,onClick,style={}}){return <button onClick={onClick} disabled={disabled} style={{padding:'11px 20px',borderRadius:9,border:'none',cursor:disabled?'not-allowed':'pointer',background:color,color:'#fff',fontSize:13,fontWeight:700,opacity:disabled?0.7:1,...style}}>{children}</button>;}
function BtnSec({children,onClick,style={}}){return <button onClick={onClick} style={{padding:'11px 18px',borderRadius:9,border:`1px solid ${B}`,cursor:'pointer',background:'#f9fafb',fontSize:13,fontWeight:500,color:'#374151',...style}}>{children}</button>;}

/* ═══════════════════════════════════════════
   PANTALLA LOGIN
═══════════════════════════════════════════ */
function LoginScreen({onLogin,passwords,configLoaded}){
  const[sel,setSel]=useState('');
  const[pass,setPass]=useState('');
  const[err,setErr]=useState('');
  const modulos=[
    {id:'recepcion',   icon:'🧾',label:'Recepción',  color:'#5b8a6e',desc:'Corte del día, ventas y comisiones'},
    {id:'gerencia',    icon:'🏢',label:'Gerencia',   color:'#b07d4a',desc:'Finanzas, inventario, gastos'},
    {id:'direccion',   icon:'📋',label:'Dirección',  color:'#7c6ab5',desc:'Gastos, configuración, visión global'},
    {id:'solicitudes', icon:'📬',label:'Solicitudes',color:'#0369a1',desc:'Pedir insumos, descansos, avisos'},
  ];
  function attempt(){
    if(!configLoaded){setErr('Cargando configuración, espera un momento…');return;}
    if(!sel){setErr('Selecciona un módulo');return;}
    // pw viene de Google Sheets (Config). Si está vacía, no se requiere contraseña.
    const pwKey={recepcion:'cajera',gerencia:'tesorera',direccion:'cajaMayor',solicitudes:'solicitudes'}[sel]||sel;
    const pw=(passwords[pwKey]||'').trim();
    const passInput=pass.trim();
    if(pw&&passInput!==pw){setErr('Contraseña incorrecta');return;}
    onLogin(sel);
  }
  return(
    <div style={{minHeight:'100vh',width:'100%',background:'linear-gradient(135deg,#3d4275 0%,#656b9c 100%)',display:'flex',alignItems:'center',justifyContent:'center',padding:20}}>
      <div style={{background:'#fff',borderRadius:16,padding:40,width:'100%',maxWidth:460,boxShadow:'0 20px 60px rgba(0,0,0,.3)',borderTop:'4px solid #eddbc2'}}>
        <div style={{textAlign:'center',marginBottom:32}}>
          <div style={{display:"flex",flexDirection:"column",alignItems:"center",gap:0}}><img src="data:image/png;base64," alt="Moyenei" style={{width:130,height:130,objectFit:"contain",objectPosition:"center bottom",marginBottom:-8}}/><div style={{fontSize:22,fontWeight:800,color:"#3d4275",letterSpacing:2}}>MOYENEI</div><div style={{fontSize:11,color:"#656b9c",letterSpacing:3,fontWeight:600,marginTop:2}}>SYSTEM</div></div>
          <p style={{fontSize:13,color:'#6b7280',marginTop:4}}>Sistema de gestión interna · Selecciona tu módulo</p>
        </div>
        <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:10,marginBottom:24}}>
          {modulos.map(m=>(
            <button key={m.id} onClick={()=>{setSel(m.id);setErr('');setPass('');}} style={{padding:'14px 12px',borderRadius:10,border:`2px solid ${sel===m.id?m.color:B}`,background:sel===m.id?m.color+'18':'#faf9f7',cursor:'pointer',textAlign:'left',transition:'all .15s'}}>
              <div style={{fontSize:22,marginBottom:4}}>{m.icon}</div>
              <div style={{fontSize:13,fontWeight:700,color:sel===m.id?m.color:'#111827'}}>{m.label}</div>
              <div style={{fontSize:10,color:'#6b7280',marginTop:2,lineHeight:1.4}}>{m.desc}</div>
            </button>
          ))}
        </div>
        {sel&&(
          <div style={{marginBottom:20}}>
            <Lbl>Contraseña</Lbl>
            <input type="password" value={pass} onChange={e=>{setPass(e.target.value);setErr('');}} onKeyDown={e=>e.key==='Enter'&&attempt()} placeholder="Ingresa tu contraseña" style={{padding:'10px 14px',borderRadius:8,fontSize:14,width:'100%',border:`1.5px solid ${err?'#dc2626':B}`,background:'#fff'}} autoFocus/>
            {err&&<p style={{color:'#dc2626',fontSize:12,marginTop:6}}>{err}</p>}
          </div>
        )}
        {!configLoaded&&<div style={{textAlign:'center',fontSize:12,color:'#9ca3af',marginBottom:8}}>⌛ Cargando configuración…</div>}
        <Btn onClick={attempt} color='#656b9c' style={{width:'100%',padding:14,fontSize:15,opacity:configLoaded?1:0.6}}>
          {!configLoaded?'Cargando…':sel?`Entrar a ${modulos.find(m=>m.id===sel)?.label||''}`:'Selecciona un módulo'}
        </Btn>
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════
   SHELL (layout con sidebar)
═══════════════════════════════════════════ */
function Shell({modulo,onLogout,children,nav,activeView,setView,updated,onRefresh,loading,alertCount=0}){
  const[collapsed,setCollapsed]=useState(false);
  const colors={recepcion:'#5b8a6e',gerencia:'#b07d4a',direccion:'#7c6ab5'};
  const color=colors[modulo]||'#656b9c';
  const labels={recepcion:'🧾 Recepción',gerencia:'🏢 Gerencia',direccion:'📋 Dirección'};
  return(
    <div style={{display:'flex',minHeight:'100vh',width:'100%',background:'#f3f2f7'}}>
      {/* Sidebar */}
      <div style={{width:collapsed?60:210,minHeight:'100vh',background:color,display:'flex',flexDirection:'column',flexShrink:0,transition:'width .2s',boxShadow:'2px 0 10px rgba(0,0,0,.18)'}}>
        <div onClick={()=>setCollapsed(!collapsed)} style={{padding:'16px 12px',borderBottom:'1px solid rgba(255,255,255,.15)',display:'flex',alignItems:'center',gap:10,cursor:'pointer',userSelect:'none'}}>
          <img src="data:image/png;base64," alt="Moyenei" style={{width:30,height:30,objectFit:"contain",flexShrink:0}}/>
          {!collapsed&&<div><div style={{color:'#fff',fontWeight:700,fontSize:12,lineHeight:1.3}}>Moyenei</div><div style={{color:'rgba(255,255,255,.6)',fontSize:10}}>{labels[modulo]}</div></div>}
        </div>
        <nav style={{flex:1,padding:'10px 6px',display:'flex',flexDirection:'column',gap:2}}>
          {nav.map(n=>(
            <button key={n.id} onClick={()=>setView(n.id)} style={{display:'flex',alignItems:'center',gap:10,padding:'9px 8px',borderRadius:8,border:'none',cursor:'pointer',width:'100%',textAlign:'left',fontSize:12,fontWeight:activeView===n.id?700:400,background:activeView===n.id?'rgba(255,255,255,.2)':'transparent',color:activeView===n.id?'#fff':'rgba(255,255,255,.7)',position:'relative'}}>
              <span style={{fontSize:15,flexShrink:0,width:18,textAlign:'center'}}>{n.icon}</span>
              {!collapsed&&<span>{n.label}</span>}
              {n.id==='dashboard'&&alertCount>0&&<span style={{position:'absolute',top:4,left:22,background:'#ef4444',color:'#fff',fontSize:9,fontWeight:700,borderRadius:9999,minWidth:14,height:14,display:'flex',alignItems:'center',justifyContent:'center',padding:'0 2px'}}>{alertCount}</span>}
            </button>
          ))}
        </nav>
        <button onClick={onLogout} style={{margin:'8px',padding:'8px',borderRadius:8,border:'1px solid rgba(255,255,255,.2)',background:'transparent',color:'rgba(255,255,255,.7)',cursor:'pointer',fontSize:11,display:'flex',alignItems:'center',gap:6,justifyContent:collapsed?'center':'flex-start'}}>
          <span>🚪</span>{!collapsed&&'Cerrar sesión'}
        </button>
      </div>
      {/* Main */}
      <div style={{flex:1,display:'flex',flexDirection:'column',minWidth:0}}>
        <div style={{background:'#fff',padding:'12px 22px',borderBottom:`1px solid ${B}`,display:'flex',alignItems:'center',justifyContent:'space-between',boxShadow:'0 1px 6px rgba(101,107,156,.12)'}}>
          <div><h1 style={{fontSize:16,fontWeight:700,color:'#111827'}}>{nav.find(n=>n.id===activeView)?.label||''}</h1><div style={{fontSize:11,color:'#9ca3af',marginTop:1}}>Actualizado: {fNow(updated)}</div></div>
          <button onClick={onRefresh} disabled={loading} style={{display:'flex',alignItems:'center',gap:6,background:color,color:'#fff',border:'none',padding:'7px 14px',borderRadius:8,cursor:'pointer',fontSize:12,fontWeight:600,opacity:loading?0.7:1}}>
            {loading?'⌛':' 🔄'} {loading?'Cargando…':'Actualizar'}
          </button>
        </div>
        <main style={{flex:1,padding:20,overflowY:'auto'}}>{children}</main>
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════
   MÓDULO CAJERA
═══════════════════════════════════════════ */
function ModuloCajera({onLogout,personal=[],metaDia=7000,notas=[],setNotas}){
  const[view,setView]=useState('cierre');
  const[data,setData]=useState(null);
  const[loading,setLoading]=useState(false);
  const[toast,setToast]=useState(null);
  const[updated,setUpdated]=useState(new Date());
  const[celebracion,setCelebracion]=useState(null);
  function notify(msg,type='info'){setToast({message:msg,type});setTimeout(()=>setToast(null),4500);}
  const load=useCallback(async()=>{
    setLoading(true);
    try{const d=await api({action:'getCajera'});setData(d);setUpdated(new Date());}
    catch(e){notify('Error al cargar datos: '+e.message,'error');}
    finally{setLoading(false);}
  },[]);
  useEffect(()=>{load();},[]);

  const NAV=[
    {id:'cierre',    icon:'🔒',label:'Corte del Día'},
    {id:'dashboard', icon:'📊',label:'Mi Resumen'},
    {id:'historial', icon:'📋',label:'Historial'},
  ];

  async function handleCierre(form){
    setLoading(true);
    try{
      const d=await api({action:'registrarCierre',...form,fechaCorte:form.fechaCorte||localDateStr()});
      setData(d);
      setCelebracion({totalVenta:form.totalVenta,metaDia});
      setView('dashboard');
    }catch(e){notify('Error: '+e.message,'error');}
    finally{setLoading(false);}
  }

  return(<>
    <Shell modulo="recepcion" onLogout={onLogout} nav={NAV} activeView={view} setView={setView} updated={updated} onRefresh={load} loading={loading}>
      {view==='cierre'    &&<CajeraCorte   onSave={handleCierre} loading={loading} data={data} personal={personal} metaDia={metaDia}/>}
      {view==='dashboard' &&<CajeraResumen data={data} personal={personal} metaDia={metaDia} notas={notas} setNotas={setNotas}/>}
      {view==='historial' &&<CajeraHistorial data={data}/>}
    </Shell>
    <Toast t={toast} close={()=>setToast(null)}/>
    {celebracion&&<CelebracionModal totalVenta={celebracion.totalVenta} metaDia={celebracion.metaDia} onClose={()=>setCelebracion(null)}/>}
  </>);
}

/* ── Meta diaria progress bar ── */
function MetaProgressBar({totalVenta,metaDia}){
  if(!metaDia)return null;
  var pct=Math.min(Math.round(totalVenta/metaDia*100),100);
  var over=totalVenta>metaDia;
  var color=pct>=100?'#16a34a':pct>=80?'#5b8a6e':pct>=60?'#d97706':pct>=40?'#ea580c':'#dc2626';
  var label=pct>=100?'🏆 ¡Meta alcanzada!':pct>=80?'💪 Muy cerca':pct>=60?'👍 Buen avance':pct>=40?'⚡ Sigue adelante':'🔥 Arranca fuerte';
  return(
    <div style={{background:'#f8f8fc',border:'1px solid #dddde8',borderRadius:10,padding:'12px 16px',marginBottom:14}}>
      <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:8}}>
        <span style={{fontSize:12,fontWeight:700,color:'#374151'}}>🎯 Meta del día: {fMXN(metaDia)}</span>
        <span style={{fontSize:12,fontWeight:700,color:color}}>{label} {pct}%</span>
      </div>
      <div style={{background:'#e5e7eb',borderRadius:9999,height:12,overflow:'hidden'}}>
        <div style={{width:pct+'%',height:'100%',background:color,borderRadius:9999,transition:'width .4s ease'}}/>
      </div>
      {over&&<div style={{fontSize:11,color:'#16a34a',marginTop:6,fontWeight:600}}>
        ✨ Superaste la meta por {fMXN(totalVenta-metaDia)}
      </div>}
    </div>
  );
}

/* ── Celebración post-cierre ── */
function CelebracionModal({totalVenta,metaDia,onClose}){
  if(!totalVenta)return null;
  var pct=metaDia>0?totalVenta/metaDia:0;
  var alcanzo=pct>=1;
  var casi=pct>=0.8&&pct<1;
  var medio=pct>=0.5&&pct<0.8;
  // Play sound
  React.useEffect(function(){
    if(alcanzo){
      try{
        var audio=new Audio('data:audio/mp3;base64,');
        audio.volume=0.8;
        audio.play().catch(function(){});
      }catch(e){}
    }
  },[]);
  var bg=alcanzo?'linear-gradient(135deg,#16a34a,#15803d)':casi?'linear-gradient(135deg,#b07d4a,#92652d)':'linear-gradient(135deg,#656b9c,#3d4275)';
  var emoji=alcanzo?'🏆':casi?'💪':'🌱';
  var titulo=alcanzo?'¡Felicitaciones! ¡Meta alcanzada!':casi?'¡Muy bien! Casi llegamos':medio?'Buen esfuerzo, mañana más':'Corte registrado';
  var msg=alcanzo?'Excelente trabajo hoy. Sigue así, ¡eres increíble!':casi?'Estuviste muy cerca de la meta. ¡Mañana lo logras!':medio?'Cada día es una oportunidad. ¡Tú puedes hacerlo mejor!':'Registrado con éxito. ¡Mañana será un gran día!';
  var btnTxt=alcanzo?'💪 ¡A seguir así!':casi?'🔥 ¡Me esforzaré más!':'✨ ¡Mañana lo lograré!';
  return(
    <div style={{position:'fixed',inset:0,background:'rgba(0,0,0,.7)',zIndex:2000,display:'flex',alignItems:'center',justifyContent:'center',padding:20}}>
      <div style={{background:'#fff',borderRadius:20,padding:0,maxWidth:420,width:'100%',overflow:'hidden',boxShadow:'0 25px 60px rgba(0,0,0,.4)'}}>
        <div style={{background:bg,padding:'32px 28px',textAlign:'center'}}>
          <div style={{fontSize:64,marginBottom:12}}>{emoji}</div>
          <div style={{fontSize:20,fontWeight:800,color:'#fff',marginBottom:8}}>{titulo}</div>
          <div style={{fontSize:28,fontWeight:800,color:'rgba(255,255,255,.9)'}}>{fMXN(totalVenta)}</div>
          {metaDia>0&&<div style={{fontSize:13,color:'rgba(255,255,255,.7)',marginTop:4}}>{Math.round(pct*100)}% de la meta de {fMXN(metaDia)}</div>}
        </div>
        <div style={{padding:'24px 28px',textAlign:'center'}}>
          <p style={{fontSize:14,color:'#374151',lineHeight:1.7,marginBottom:20}}>{msg}</p>
          <button onClick={onClose}
            style={{width:'100%',padding:'14px',borderRadius:10,border:'none',
              background:alcanzo?'#16a34a':casi?'#b07d4a':'#656b9c',
              color:'#fff',fontSize:15,fontWeight:700,cursor:'pointer'}}>
            {btnTxt}
          </button>
        </div>
      </div>
    </div>
  );
}

/* ── StilComisionPreview helper ── */
function StilComisionPreview({monto,estilista,personal}){
  const so=personal.find(p=>p.nombre===estilista);
  const sp=(so?.pct||30)/100;
  return <div style={{fontSize:11,color:'#0f6e56',marginTop:8}}>Comisión {so?.pct||30}%: <strong>{fMXN(Number(monto)*sp)}</strong></div>;
}

/* ── Corte del Día (formulario único) ── */
function CajeraCorte({onSave,loading,data,personal=[],metaDia=7000}){
  const EMPTY={
    efectivo:'', tarjeta:'', transferencia:'',
    salidaConcepto:'', salidaMonto:'', salidaCuenta:'Efectivo',
    quedaEnCaja:'', recepcionista:'', notas:'',
    fechaCorte:localDateStr()
  };
  const[f,setF]=useState(EMPTY);
  const[errs,setErrs]=useState({});
  const[confirmando,setConfirmando]=useState(false);
  // Servicios de doctoras: lista de {id, concepto, monto, doctora}
  const[servicios,setServicios]=useState([]);
  // Derive role-specific lists from personal
  const recepcionistas=useMemo(()=>personal.filter(p=>p.rol==='Recepcionista'),[personal]);
  const doctoras=useMemo(()=>personal.filter(p=>p.rol==='Doctora'),[personal]);
  const estilistas=useMemo(()=>personal.filter(p=>p.rol==='Estilista'),[personal]);
  const[svcForm,setSvcForm]=useState({concepto:'',monto:'',doctora:''});
  const[stilForm,setStilForm]=useState({estilista:'',monto:''});
  const[grooming,setGrooming]=useState([]); // [{id,estilista,monto,pct,comision}]
  // Grooming totals
  const totalGrooming=grooming.reduce((s,g)=>s+g.monto,0);
  const comisionesTotStil=grooming.reduce((s,g)=>s+g.comision,0);
  function addGrooming(){
    if(!stilForm.estilista||!stilForm.monto||Number(stilForm.monto)<=0)return;
    const stilObj=personal.find(p=>p.nombre===stilForm.estilista);
    const stilPct=(stilObj?.pct||30)/100;
    setGrooming(prev=>[...prev,{
      id:Date.now(),estilista:stilForm.estilista,
      monto:Number(stilForm.monto),
      pct:stilObj?.pct||30,
      comision:Number(stilForm.monto)*stilPct,
    }]);
    setStilForm({estilista:stilForm.estilista,monto:''});
  }
  function removeGrooming(id){setGrooming(prev=>prev.filter(g=>g.id!==id));}
  const[svcErrs,setSvcErrs]=useState({});

  function set(k,v){setF(p=>({...p,[k]:v}));if(errs[k])setErrs(e=>({...e,[k]:null}));}
  function setSvc(k,v){setSvcForm(p=>({...p,[k]:v}));if(svcErrs[k])setSvcErrs(e=>({...e,[k]:null}));}

  // Totales ventas
  const venEfectivo  = Number(f.efectivo)||0;
  const venTarjeta   = Number(f.tarjeta)||0;
  const venTransf    = Number(f.transferencia)||0;
  const totalVenta   = venEfectivo + venTarjeta + venTransf;
  // Recep commission from personal config
  const recepSelObj=useMemo(()=>personal.find(p=>p.nombre===f.recepcionista),[personal,f.recepcionista]);
  const recepPct=(recepSelObj?.pct||1.5)/100;
  const comisionRecep= totalVenta>=5000 ? totalVenta * recepPct : 0;

  // Totales salida
  const salidaMonto  = Number(f.salidaMonto)||0;
  const quedaEnCaja  = Number(f.quedaEnCaja)||0;
  const salidaEf     = f.salidaCuenta==='Efectivo'?salidaMonto:0;
  const salidaSpin   = f.salidaCuenta==='SPIN'?salidaMonto:0;
  const vaACajaFuerte= Math.max(0, venEfectivo - salidaEf - quedaEnCaja);
  const spinPendiente= Math.max(0, venTransf - salidaSpin);

  // Totales servicios doctoras
  const totalServiciosDras = servicios.reduce((s,sv)=>s+Number(sv.monto),0);
  const comisionesTotDras  = servicios.reduce((s,sv)=>s+sv.comision,0);
  // Por doctora
  const porDoctora = useMemo(()=>{
    const map={};
    servicios.forEach(sv=>{
      if(!map[sv.doctora])map[sv.doctora]={nombre:sv.doctora,servicios:[],total:0,comision:0};
      map[sv.doctora].servicios.push(sv);
      map[sv.doctora].total   +=Number(sv.monto);
      map[sv.doctora].comision+=Number(sv.monto)*0.05;
    });
    return Object.values(map);
  },[servicios]);

  // Comisión acumulada del mes por recepcionista
  const cierres=(data?.cierres||[]);
  const mesStart=localDateStr(new Date(new Date().getFullYear(),new Date().getMonth(),1));
  const comisionMesRecep=cierres
    .filter(c=>c.Fecha>=mesStart&&c.Recepcionista===f.recepcionista)
    .reduce((s,c)=>s+(Number(c.Comision)||0),0);

  // Agregar servicio a la lista
  function addServicio(){
    const e={};
    if(!svcForm.concepto.trim())e.concepto='Escribe el concepto';
    if(!svcForm.monto||Number(svcForm.monto)<=0)e.monto='Monto mayor a 0';
    if(!svcForm.doctora)e.doctora='Selecciona la doctora';
    setSvcErrs(e);
    if(Object.keys(e).length)return;
    const draObj=personal.find(p=>p.nombre===svcForm.doctora);
    const draPct=(draObj?.pct||5)/100;
    setServicios(prev=>[...prev,{
      id:Date.now(),
      concepto:svcForm.concepto.trim(),
      monto:Number(svcForm.monto),
      doctora:svcForm.doctora,
      pct:draObj?.pct||5,
      comision:Number(svcForm.monto)*draPct,
    }]);
    setSvcForm({concepto:'',monto:'',doctora:svcForm.doctora});
    setSvcErrs({});
  }
  function removeServicio(id){setServicios(prev=>prev.filter(s=>s.id!==id));}

  function validate(){
    const e={};
    if(!totalVenta)e.efectivo='Ingresa al menos un monto de venta';
    if(!f.recepcionista)e.recepcionista='Selecciona la recepcionista del día';
    if(f.salidaMonto&&!f.salidaConcepto.trim())e.salidaConcepto='Indica el concepto de la salida';
    if(f.salidaCuenta==='Efectivo'&&salidaEf>venEfectivo)
      e.salidaMonto=`No puede superar el efectivo (${fMXN(venEfectivo)})`;
    if(f.salidaCuenta==='SPIN'&&salidaSpin>venTransf)
      e.salidaMonto=`No puede superar la transferencia (${fMXN(venTransf)})`;
    if(f.quedaEnCaja==='')e.quedaEnCaja='Indica cuánto queda en caja (puede ser $0)';
    if(quedaEnCaja>venEfectivo-salidaEf)
      e.quedaEnCaja=`No puede superar el efectivo disponible (${fMXN(venEfectivo-salidaEf)})`;
    // Verificar que no exista ya un corte para esa fecha
    const fechaSel=f.fechaCorte||localDateStr();
    const yaExiste=(data?.cierres||[]).some(function(c){return String(c.Fecha).slice(0,10)===fechaSel;});
    if(yaExiste)e.fechaCorte='Ya existe un corte para el '+fDate(fechaSel)+'. Solo se permite uno por día.';
    setErrs(e);
    return!Object.keys(e).length;
  }

  function submit(){
    if(!validate())return;
    const porEstilista=grooming.reduce((m,g)=>{if(!m[g.estilista])m[g.estilista]={nombre:g.estilista,total:0,comision:0,pct:g.pct};m[g.estilista].total+=g.monto;m[g.estilista].comision+=g.comision;return m;},{});
    onSave({
      efectivo:venEfectivo, tarjeta:venTarjeta, transferencia:venTransf,
      totalVenta, comision:comisionRecep,
      salidaConcepto:f.salidaConcepto, salidaMonto, salidaCuenta:f.salidaCuenta,
      quedaEnCaja, vaACajaFuerte, spinPendiente,
      recepcionista:f.recepcionista, notas:f.notas, fechaCorte:f.fechaCorte,
      serviciosDras:JSON.stringify(servicios),
      totalServiciosDras, comisionesTotDras,
      comisionesDras:JSON.stringify(porDoctora.map(d=>({nombre:d.nombre,total:d.total,comision:d.comision}))),
      totalGrooming, comisionesTotStil,
      comisionesStil:JSON.stringify(Object.values(porEstilista)),
    });
    setF(EMPTY);setErrs({});setServicios([]);setGrooming([]);setConfirmando(false);
  }

  const inp=k=>({padding:'10px 13px',borderRadius:8,fontSize:14,width:'100%',
    border:`1.5px solid ${errs[k]?'#dc2626':'#d1d5db'}`,background:'#fff'});
  const inpSvc=k=>({padding:'9px 12px',borderRadius:8,fontSize:13,width:'100%',
    border:`1.5px solid ${svcErrs[k]?'#dc2626':'#d1d5db'}`,background:'#fff'});
  const secTitle=(icon,txt,right)=>(
    <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',
      marginBottom:12,paddingBottom:8,borderBottom:`2px solid ${B}`}}>
      <div style={{fontSize:13,fontWeight:700,color:'#374151',display:'flex',alignItems:'center',gap:8}}>
        <span>{icon}</span>{txt}
      </div>
      {right}
    </div>
  );

  return(
    <div style={{maxWidth:720}}>
      <Card style={{padding:28}}>
        <h2 style={{fontSize:18,fontWeight:800,color:'#111827',marginBottom:4}}>🔒 Corte del Día</h2>
        <p style={{fontSize:12,color:'#6b7280',marginBottom:24}}>
          Registra ventas, servicios de doctoras, salida y efectivo que se queda en caja.
        </p>

        {/* ══ SECCIÓN 1: Ventas ══ */}
        {secTitle('💰','1. Ventas del día')}
        <div style={{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:12,marginBottom:12}}>
          {[
            ['efectivo',      '💵 Efectivo',           '#16a34a'],
            ['tarjeta',       '💳 Tarjeta (BBVA)',      '#7c3aed'],
            ['transferencia', '📲 Transferencia (SPIN)', '#0369a1'],
          ].map(([k,lbl,col])=>(
            <div key={k}>
              <label style={{fontSize:11,fontWeight:700,color:'#374151',display:'block',marginBottom:4}}>{lbl}</label>
              <div style={{position:'relative'}}>
                <span style={{position:'absolute',left:10,top:'50%',transform:'translateY(-50%)',color:'#9ca3af',fontSize:13}}>$</span>
                <input type="number" min="0" step="0.01" value={f[k]}
                  onChange={e=>set(k,e.target.value)} placeholder="0.00"
                  style={{...inp(k),paddingLeft:22}}/>
              </div>
            </div>
          ))}
        </div>
        {errs.efectivo&&<Err msg={errs.efectivo}/>}

        {/* Panel total venta + comisión recepcionista */}
        {totalVenta>0&&<MetaProgressBar totalVenta={totalVenta} metaDia={metaDia}/>}
        {totalVenta>0&&(
          <div style={{background:'#f0fdf4',border:'1px solid #86efac',borderRadius:10,
            padding:'14px 18px',marginBottom:18}}>
            <div style={{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:12}}>
              <div style={{textAlign:'center'}}>
                <div style={{fontSize:11,color:'#374151',marginBottom:3}}>Total Venta</div>
                <div style={{fontSize:26,fontWeight:800,color:'#5b8a6e'}}>{fMXN(totalVenta)}</div>
              </div>
              <div style={{textAlign:'center',borderLeft:`1px solid #bbf7d0`,paddingLeft:12}}>
                <div style={{fontSize:11,color:'#374151',marginBottom:3}}>Comisión recep. ({totalVenta>=5000?((recepPct*100).toFixed(1)+'%'):'min. $5,000'})</div>
                <div style={{fontSize:22,fontWeight:800,color:'#16a34a'}}>{fMXN(comisionRecep)}</div>
              </div>
              <div style={{textAlign:'center',borderLeft:`1px solid #bbf7d0`,paddingLeft:12}}>
                <div style={{fontSize:11,color:'#374151',marginBottom:3}}>Acumulado mes</div>
                <div style={{fontSize:20,fontWeight:800,color:'#0369a1'}}>{fMXN(comisionMesRecep+comisionRecep)}</div>
                <div style={{fontSize:10,color:'#6b7280'}}>{f.recepcionista||'—'}</div>
              </div>
            </div>
          </div>
        )}

        {/* Fecha del corte */}
        <div style={{marginBottom:18}}>
          <Lbl req>Fecha del corte</Lbl>
          <input type="date" value={f.fechaCorte} onChange={e=>set('fechaCorte',e.target.value)}
            style={{padding:'10px 13px',borderRadius:8,fontSize:14,width:'100%',border:'1.5px solid '+(errs.fechaCorte?'#dc2626':'#d1d5db'),background:'#fff'}}/>
          {f.fechaCorte!==localDateStr()&&!errs.fechaCorte&&(
            <div style={{fontSize:11,color:'#d97706',marginTop:4}}>⚠️ Registrando corte para una fecha pasada: {fDate(f.fechaCorte)}</div>
          )}
          {errs.fechaCorte&&<div style={{fontSize:11,color:'#dc2626',marginTop:4,fontWeight:600}}>❌ {errs.fechaCorte}</div>}
        </div>

        {/* Recepcionista */}
        <div style={{marginBottom:22}}>
          <Lbl req>Recepcionista del día</Lbl>
          <select value={f.recepcionista} onChange={e=>set('recepcionista',e.target.value)} style={inp('recepcionista')}>
            <option value="">— Seleccionar —</option>
            {recepcionistas.map(r=><option key={r.nombre} value={r.nombre}>{r.nombre} ({r.pct}%)</option>)}
          </select>
          <Err msg={errs.recepcionista}/>
        </div>

        {/* ══ SECCIÓN 2: Servicios de Doctoras ══ */}
        {secTitle('👩‍⚕️','2. Servicios de Doctoras (comisión 5%)',
          servicios.length>0&&<span style={{fontSize:12,fontWeight:700,color:'#9d174d'}}>
            {servicios.length} servicio{servicios.length>1?'s':''} · {fMXN(comisionesTotDras)} comisión total
          </span>
        )}
        <p style={{fontSize:11,color:'#6b7280',marginBottom:12}}>
          Registra cada servicio o venta cerrada por las doctoras. Puedes agregar varios.
        </p>

        {/* Formulario agregar servicio */}
        <div style={{background:'#fdf4ff',border:'1px solid #e9d5ff',borderRadius:10,
          padding:'14px 16px',marginBottom:14}}>
          <div style={{display:'grid',gridTemplateColumns:'1fr auto',gap:10,marginBottom:10}}>
            <div>
              <label style={{fontSize:11,fontWeight:700,color:'#374151',display:'block',marginBottom:4}}>Concepto del servicio</label>
              <input value={svcForm.concepto} onChange={e=>setSvc('concepto',e.target.value)}
                onKeyDown={e=>e.key==='Enter'&&addServicio()}
                placeholder="Ej: Consulta, Procedimiento estético, Limpieza…"
                style={inpSvc('concepto')}/>
              {svcErrs.concepto&&<Err msg={svcErrs.concepto}/>}
            </div>
            <div style={{minWidth:130}}>
              <label style={{fontSize:11,fontWeight:700,color:'#374151',display:'block',marginBottom:4}}>Monto del servicio ($)</label>
              <div style={{position:'relative'}}>
                <span style={{position:'absolute',left:10,top:'50%',transform:'translateY(-50%)',color:'#9ca3af',fontSize:13}}>$</span>
                <input type="number" min="0" step="0.01" value={svcForm.monto}
                  onChange={e=>setSvc('monto',e.target.value)}
                  onKeyDown={e=>e.key==='Enter'&&addServicio()}
                  placeholder="0.00" style={{...inpSvc('monto'),paddingLeft:22}}/>
              </div>
              {svcErrs.monto&&<Err msg={svcErrs.monto}/>}
            </div>
          </div>
          <div style={{display:'grid',gridTemplateColumns:'1fr auto',gap:10,alignItems:'flex-end'}}>
            <div>
              <label style={{fontSize:11,fontWeight:700,color:'#374151',display:'block',marginBottom:4}}>Doctora</label>
              <select value={svcForm.doctora} onChange={e=>setSvc('doctora',e.target.value)} style={inpSvc('doctora')}>
                <option value="">— Seleccionar —</option>
                {doctoras.map(d=><option key={d.nombre} value={d.nombre}>{d.nombre} ({d.pct}%)</option>)}
              </select>
              {svcErrs.doctora&&<Err msg={svcErrs.doctora}/>}
            </div>
            <Btn onClick={addServicio} color="#9d174d" style={{padding:'10px 18px',whiteSpace:'nowrap'}}>
              + Agregar
            </Btn>
          </div>
          {svcForm.monto>0&&<div style={{fontSize:11,color:'#7e22ce',marginTop:8}}>
            Comisión 5%: <strong>{fMXN(Number(svcForm.monto)*0.05)}</strong>
          </div>}
        </div>

        {/* Lista de servicios agregados */}
        {servicios.length>0&&(
          <div style={{display:'flex',flexDirection:'column',gap:6,marginBottom:18}}>
            {servicios.map(sv=>(
              <div key={sv.id} style={{display:'flex',alignItems:'center',gap:10,
                padding:'9px 12px',borderRadius:8,background:'#faf5ff',border:'1px solid #e9d5ff'}}>
                <span style={{fontSize:13,flex:1,color:'#111827',fontWeight:500}}>{sv.concepto}</span>
                <span style={{fontSize:11,color:'#9d174d',background:'#fce7f3',padding:'2px 8px',borderRadius:9999,fontWeight:600}}>{sv.doctora}</span>
                <span style={{fontSize:13,fontWeight:700,color:'#374151',minWidth:80,textAlign:'right'}}>{fMXN(sv.monto)}</span>
                <span style={{fontSize:11,color:'#6d28d9',minWidth:75,textAlign:'right'}}>{sv.pct}%: {fMXN(sv.comision)}</span>
                <button onClick={()=>removeServicio(sv.id)}
                  style={{background:'none',border:'none',cursor:'pointer',color:'#dc2626',fontSize:18,lineHeight:1,padding:'0 4px'}}>×</button>
              </div>
            ))}
            {/* Totales servicios */}
            <div style={{display:'flex',justifyContent:'space-between',padding:'10px 14px',
              borderRadius:8,background:'#9d174d',color:'#fff',marginTop:4}}>
              <span style={{fontSize:13,fontWeight:600}}>Total servicios doctoras</span>
              <div style={{textAlign:'right'}}>
                <span style={{fontSize:13,marginRight:20}}>{fMXN(totalServiciosDras)}</span>
                <span style={{fontSize:13,fontWeight:700}}>Comisión total: {fMXN(comisionesTotDras)}</span>
              </div>
            </div>
            {/* Por doctora */}
            {porDoctora.map(d=>(
              <div key={d.nombre} style={{display:'flex',justifyContent:'space-between',
                padding:'7px 14px',borderRadius:7,background:'#fdf4ff',border:'1px solid #e9d5ff',fontSize:12}}>
                <span style={{color:'#374151',fontWeight:600}}>{d.nombre}</span>
                <span style={{color:'#6b7280'}}>{d.servicios.length} servicio{d.servicios.length>1?'s':''} · {fMXN(d.total)}</span>
                <span style={{color:'#9d174d',fontWeight:700}}>Comisión: {fMXN(d.comision)}</span>
              </div>
            ))}
          </div>
        )}

        {/* ══ SECCIÓN 3: Grooming / Estilistas ══ */}
        {secTitle('✂️','3. Grooming — Estilistas',
          grooming.length>0&&<span style={{fontSize:12,fontWeight:700,color:'#0f6e56'}}>
            {grooming.length} registro{grooming.length>1?'s':''} · {fMXN(comisionesTotStil)} comisión
          </span>
