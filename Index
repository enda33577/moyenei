function InvTransferir({inv,onTransferir,loading}){
  const[sel,setSel]=useState('');
  const[cant,setCant]=useState('');
  const prods=useMemo(function(){
    return inv.filter(function(p){return tieneDobleNivel(p.categoria)&&Number(p.stockAlmacen)>0;})
      .sort(function(a,b){return a.nombre.localeCompare(b.nombre);});
  },[inv]);
  var prod=prods.find(function(p){return p.id===sel;})||null;
  var cantN=Number(cant)||0;
  var canGo=!!sel&&cantN>0&&!!prod&&cantN<=prod.stockAlmacen;
  return(
    <div style={{maxWidth:560}}>
      <Card style={{padding:26}}>
        <h2 style={{fontSize:17,fontWeight:700,marginBottom:6}}>🔄 Transferir Almacén a Piso</h2>
        <p style={{fontSize:12,color:'#6b7280',marginBottom:22}}>Mueve unidades del almacén al área de uso o venta.</p>
        <div style={{marginBottom:16}}>
          <Lbl req>Producto</Lbl>
          <select value={sel} onChange={function(e){setSel(e.target.value);setCant('');}}
            style={{padding:'10px 13px',borderRadius:8,fontSize:14,width:'100%',border:'1.5px solid #d1d5db',background:'#fff'}}>
            <option value="">— Seleccionar producto —</option>
            {prods.map(function(p){return <option key={p.id} value={p.id}>{p.nombre} (Almacén: {p.stockAlmacen} {p.unidad})</option>;})}
          </select>
        </div>
        {prod&&(
          <div style={{background:'#f8f8fc',borderRadius:10,padding:'14px 16px',marginBottom:16,display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:12}}>
            {[['Almacén',prod.stockAlmacen,'#656b9c'],['Piso actual',prod.stockPiso,'#5b8a6e'],['Mín. Piso',prod.minPiso||0,'#b07d4a']].map(function(item){return(
              <div key={item[0]} style={{textAlign:'center'}}>
                <div style={{fontSize:11,color:'#6b7280',marginBottom:3}}>{item[0]}</div>
                <div style={{fontSize:20,fontWeight:700,color:item[2]}}>{item[1]}</div>
              </div>
            );})}
          </div>
        )}
        <div style={{marginBottom:20}}>
          <Lbl req>Cantidad a transferir</Lbl>
          <input type="number" min="1" value={cant} onChange={function(e){setCant(e.target.value);}}
            placeholder="0" style={{padding:'10px 13px',borderRadius:8,fontSize:14,width:'100%',border:'1.5px solid #d1d5db',background:'#fff'}}/>
          {prod&&cantN>0&&(
            <div style={{fontSize:12,color:'#5b8a6e',marginTop:6}}>
              Almacén quedará en: <strong>{prod.stockAlmacen-cantN}</strong> · Piso quedará en: <strong>{Number(prod.stockPiso)+cantN}</strong>
            </div>
          )}
        </div>
        <Btn onClick={function(){if(canGo){onTransferir(sel,prod.nombre,cantN);setSel('');setCant('');}}}
          disabled={loading||!canGo}
          color="#656b9c" style={{width:'100%',padding:13,fontSize:14}}>
          {loading?'⌛ Procesando…':'🔄 Transferir a Piso'}
        </Btn>
      </Card>
    </div>
  );
}

