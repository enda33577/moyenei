function ModuloSolicitudes({onLogout,personal=[],inv=[],solicitudes=[],setSolicitudes,asuetos={},notas=[],setNotas}){
  const[form,setForm]=useState({
    solicitante:'',
    tipo:'producto',   // 'producto' | 'descanso' | 'otro'
    productoSel:'',
    productoLibre:'',
    cantidad:1,
    mensaje:'',
  });
  const[enviado,setEnviado]=useState(false);
  const[verCal,setVerCal]=useState(false);
  const[errs,setErrs]=useState({});

  var insumos=inv.filter(function(p){return p.categoria&&(p.categoria.indexOf('Insumo')>-1||p.categoria==='Mercancía');});

  function set(k,v){setForm(function(f){var n=Object.assign({},f);n[k]=v;return n;});}

  function validate(){
    var e={};
    if(!form.solicitante)e.solicitante='Selecciona tu nombre';
    if(form.tipo==='producto'&&!form.productoSel&&!form.productoLibre.trim())e.producto='Indica qué producto necesitas';
    if(form.tipo!=='producto'&&!form.mensaje.trim())e.mensaje='Escribe tu solicitud';
    setErrs(e);
    return Object.keys(e).length===0;
  }

  function enviar(){
    if(!validate())return;
    var nueva={
      id:Date.now(),
      fecha:localDateStr(),
      hora:new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'}),
      solicitante:form.solicitante,
      tipo:form.tipo,
      producto:form.tipo==='producto'?(form.productoSel||form.productoLibre.trim()):'',
      productoId:form.tipo==='producto'&&form.productoSel?(inv.find(function(p){return p.nombre===form.productoSel;})||{}).id||'':'',
      cantidad:form.tipo==='producto'?Number(form.cantidad)||1:0,
      mensaje:form.mensaje.trim(),
      estado:'pendiente',
    };
    setSolicitudes(function(prev){return[...prev,nueva];});
    setEnviado(true);
  }

  function reset(){
