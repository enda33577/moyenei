function CajaMayorDashboard({data,personal=[],rhData={},asistencia={}}){
  if(!data)return <div style={{textAlign:'center',padding:60,color:'#6b7280'}}>⌛ Cargando…</div>;
  var r=data.tesoreria?data.tesoreria.resumen:{};
  var cierres=data.tesoreria&&data.tesoreria.cierres?data.tesoreria.cierres:[];
  var movTes=data.tesoreria&&data.tesoreria.movTesoreria?data.tesoreria.movTesoreria:[];
  var movCM=data.movCajaMayor||[];

  // ── Venta total (todos los cierres) ──
  var ventaTotal=cierres.reduce(function(s,c){return s+Number(c.TotalVenta||0);},0);

  // ── Salidas de Gerencia ──
  var salidasGerencia=movTes.reduce(function(s,m){return s+Number(m.Monto||0);},0);

  // ── Salidas de Dirección ──
  var salidasDireccion=movCM.reduce(function(s,m){return s+Number(m.Monto||0);},0);

  // ── Comisiones acumuladas (de cierres) ──
  var comisionesRecep=cierres.reduce(function(s,c){return s+Number(c.Comision||0);},0);
  var comisionesDras=cierres.reduce(function(s,c){return s+Number(c.ComisionesTotDras||0);},0);
  var comisionesEstil=cierres.reduce(function(s,c){return s+Number(c.ComisionesTotStil||0);},0);
  var totalComisiones=comisionesRecep+comisionesDras+comisionesEstil;

  // ── Nóminas acumuladas (sueldo adeudado a cada persona) ──
  var totalNomina=personal.reduce(function(sum,p){
    var rh=rhData[p.nombre]||{tarifa:0,tipoPago:'dia',pagadoHasta:null};
    var pagadoHasta=rh.pagadoHasta||'1900-01-01';
    var keys=Object.keys(asistencia).filter(function(k){
      return k.startsWith(p.nombre+'_')&&k.slice(p.nombre.length+1)>pagadoHasta;
    });
    var diasT=keys.filter(function(k){return asistencia[k]==='tiempo';}).length;
    var rets=keys.filter(function(k){return asistencia[k]==='retardo';}).length;
    var retG=keys.filter(function(k){return asistencia[k]==='retardo_grave';}).length;
    var faltas=keys.filter(function(k){return asistencia[k]==='falta';}).length;
    var descDias=Math.floor(rets/3)+retG*0.5+faltas;
    var base=rh.tipoPago==='dia'?(diasT-descDias)*Number(rh.tarifa||0):Number(rh.tarifa||0);
    return sum+Math.max(0,base);
  },0);

  // ── TOTALES ──
  var totalSalidas=salidasGerencia+salidasDireccion+totalComisiones+totalNomina;
  var balance=ventaTotal-totalSalidas;
  var porCat=Object.entries(movCM.reduce(function(m,x){var k=x.Categoría||'Otro';m[k]=(m[k]||0)+Number(x.Monto||0);return m;},{})).sort(function(a,b){return b[1]-a[1];});

  return(
    <div style={{display:'flex',flexDirection:'column',gap:16}}>
      {/* Balance real — las 3 métricas principales */}
      <div style={{background:'linear-gradient(135deg,#3d4275,#656b9c)',borderRadius:14,padding:'24px 28px',color:'#fff'}}>
        <div style={{fontSize:12,fontWeight:700,color:'rgba(255,255,255,.7)',marginBottom:16,letterSpacing:1}}>BALANCE GENERAL</div>
        <div style={{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:0}}>
          {[
            ['💰 Venta Total',ventaTotal,'rgba(255,255,255,.15)','#4ade80'],
            ['📤 Salida Total',totalSalidas,'rgba(255,255,255,.1)','#f87171'],
            ['📊 Balance Real',balance,balance>=0?'rgba(74,222,128,.2)':'rgba(248,113,113,.2)',balance>=0?'#4ade80':'#f87171'],
          ].map(function(item,i){return(
            <div key={item[0]} style={{padding:'16px 20px',background:item[2],borderLeft:i>0?'1px solid rgba(255,255,255,.15)':'none',borderRadius:i===0?'8px 0 0 8px':i===2?'0 8px 8px 0':'0'}}>
              <div style={{fontSize:11,color:'rgba(255,255,255,.7)',marginBottom:6}}>{item[0]}</div>
              <div style={{fontSize:22,fontWeight:800,color:item[3]}}>{fMXN(Math.abs(item[1]))}</div>
              {i===2&&<div style={{fontSize:10,color:'rgba(255,255,255,.6)',marginTop:3}}>{balance>=0?'superávit':'déficit'}</div>}
            </div>
          );})}
        </div>
      </div>

      {/* Desglose de salidas */}
      <Card>
        <STitle icon="📤">Desglose de Salidas</STitle>
        <div style={{display:'flex',flexDirection:'column',gap:8}}>
          {[
            ['🏢 Gastos Gerencia',       salidasGerencia,  '#b07d4a','#fff7ed'],
            ['📋 Gastos Dirección',       salidasDireccion, '#7c6ab5','#ede9fe'],
            ['🎯 Comisiones equipo',      totalComisiones,  '#16a34a','#dcfce7'],
            ['👥 Nóminas acumuladas',     totalNomina,      '#0369a1','#dbeafe'],
          ].map(function(item){return(
            <div key={item[0]} style={{display:'flex',justifyContent:'space-between',alignItems:'center',
              padding:'10px 14px',borderRadius:9,background:item[3],border:'1px solid rgba(0,0,0,.05)'}}>
              <span style={{fontSize:13,color:'#374151',fontWeight:500}}>{item[0]}</span>
              <span style={{fontSize:14,fontWeight:700,color:item[2]}}>{fMXN(item[1])}</span>
            </div>
          );})}
          <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',
            padding:'11px 14px',borderRadius:9,background:'#1e1e2e',marginTop:4}}>
            <span style={{fontSize:13,color:'rgba(255,255,255,.8)',fontWeight:700}}>Total salidas</span>
            <span style={{fontSize:16,fontWeight:800,color:'#f87171'}}>{fMXN(totalSalidas)}</span>
          </div>
        </div>
      </Card>

      {/* Desglose comisiones */}
      {totalComisiones>0&&(
        <Card>
          <STitle icon="🎯">Desglose de Comisiones</STitle>
          <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:10}}>
            {[['🧾 Recepcionistas',comisionesRecep,'#5b8a6e'],['👩‍⚕️ Doctoras',comisionesDras,'#9d174d'],['✂️ Estilistas',comisionesEstil,'#0f6e56']].map(function(item){return(
              <div key={item[0]} style={{textAlign:'center',background:'#f8faff',borderRadius:9,padding:'12px 8px'}}>
                <div style={{fontSize:11,color:'#6b7280',marginBottom:4}}>{item[0]}</div>
                <div style={{fontSize:16,fontWeight:700,color:item[2]}}>{fMXN(item[1])}</div>
              </div>
            );})}
          </div>
        </Card>
      )}

      {/* Saldos disponibles */}
      <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:12}}>
        <KPI icon="🏦" label="Caja Fuerte"  value={fMXN(r.saldoCajaFuerte||0)} sub="efectivo"       accent="#656b9c" bg="#ecedf7"/>
        <KPI icon="📲" label="SPIN"          value={fMXN(r.saldoSPIN||0)}       sub="transferencias" accent="#0369a1" bg="#dbeafe"/>
        <KPI icon="💳" label="BBVA"          value={fMXN(r.saldoBBVA||0)}       sub="tarjetas"       accent="#7c6ab5" bg="#ede9fe"/>
        <KPI icon="💰" label="Total líquido" value={fMXN((r.saldoCajaFuerte||0)+(r.saldoSPIN||0)+(r.saldoBBVA||0))} sub="en cuentas" accent="#b07d4a" bg="#fef9c3"/>
      </div>

      {/* Salidas Dirección por categoría */}
      {porCat.length>0&&(
        <Card>
          <STitle icon="📊">Salidas Dirección por Categoría</STitle>
          <CJChart type="bar" labels={porCat.map(function(x){return x[0];})} datasets={[{label:'Monto',data:porCat.map(function(x){return x[1];}),backgroundColor:CHART_COLORS,borderRadius:4}]} options={{plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return' '+fMXN(ctx.raw);}}}},scales:{y:{ticks:{callback:function(v){return fMXN(v);}}}}}}/>
        </Card>
      )}
    </div>
  );
}

