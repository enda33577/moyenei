function TesoreraDashboard({data}){
  if(!data)return <div style={{textAlign:'center',padding:60,color:'#6b7280'}}>⌛ Cargando…</div>;
  const r=data.resumen||{};
  const cierres=data.cierres||[];
  const ultimo=cierres.length>0?cierres[cierres.length-1]:null;
  const fondoCaja=ultimo?Number(ultimo.QuedaEnCaja)||0:0;
  const saldoTotal=(r.saldoCajaFuerte||0)+(r.saldoSPIN||0)+(r.saldoBBVA||0)+fondoCaja;

  return(
