/* ── Registro de Gasto (Gerencia) ── */
function TesoreraGasto({onSave,loading,data,inv,personal,cats=[],subcats=[]}){
  const r=data?.resumen||{};
  const EMPTY={concepto:'',categoria:'',subcategoria:'',cuenta:'Efectivo (Caja Fuerte)',monto:'',responsable:'',notas:'',producto:'',cantidad:'',costoUnitario:''};
  const[f,setF]=useState(EMPTY);
  const[errs,setErrs]=useState({});
  function set(k,v){setF(p=>({...p,[k]:v}));if(errs[k])setErrs(e=>({...e,[k]:null}));}

  const allCats=useMemo(()=>[...new Set([...(cats||[]),...inv.map(i=>i.Categoría).filter(Boolean),'Nómina','Servicios','Mantenimiento','Impuestos','Proveedores','Otro'])].sort(),[cats,inv]);
  const allSubcats=useMemo(()=>[...new Set([...(subcats||[]),...inv.filter(i=>!f.categoria||i.Categoría===f.categoria).map(i=>i.Subcategoría).filter(Boolean)])].sort(),[subcats,inv,f.categoria]);
  const prods=useMemo(()=>inv.map(i=>i.Nombre).sort(),[inv]);
  const saldoMap={'Efectivo (Caja Fuerte)':r.saldoCajaFuerte||0,'SPIN':r.saldoSPIN||0,'BBVA':r.saldoBBVA||0};
  const saldoActual=saldoMap[f.cuenta]||0;
  const esInventario=f.categoria==='Inventario';
  const selProd=inv.find(i=>i.Nombre===f.producto);
  const costoT=f.monto?Number(f.monto):0;

  function validate(){
    const e={};
    if(!f.concepto.trim())e.concepto='Requerido';
    if(!f.categoria)e.categoria='Requerido';
    if(!f.monto||Number(f.monto)<=0)e.monto='Monto mayor a 0';
    if(Number(f.monto)>saldoActual)e.monto=`Insuficiente en ${f.cuenta} (${fMXN(saldoActual)})`;
    if(!f.responsable)e.responsable='Requerido';
    if(esInventario&&!f.producto)e.producto='Selecciona el producto';
    if(esInventario&&(!f.cantidad||Number(f.cantidad)<=0))e.cantidad='Cantidad requerida';
    setErrs(e);return!Object.keys(e).length;
  }

  const inp=k=>({padding:'10px 13px',borderRadius:8,fontSize:13,width:'100%',border:`1.5px solid ${errs[k]?'#dc2626':'#d1d5db'}`,background:'#fff'});

  return(
    <div style={{maxWidth:680}}>
      <Card style={{padding:26}}>
        <h2 style={{fontSize:17,fontWeight:700,marginBottom:6}}>🔽 Registrar Gasto de Tesorería</h2>
        <p style={{fontSize:12,color:'#6b7280',marginBottom:20}}>Inventario, nómina, servicios, mantenimiento, etc.</p>

        {/* Saldos disponibles */}
        <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:10,marginBottom:20}}>
          {[['🏦 Caja Fuerte',r.saldoCajaFuerte||0,'#656b9c'],['📲 SPIN',r.saldoSPIN||0,'#0369a1'],['💳 BBVA',r.saldoBBVA||0,'#7c6ab5']].map(([lbl,val,col])=>(
            <div key={lbl} style={{textAlign:'center',padding:'8px 12px',borderRadius:8,background:f.cuenta.includes(lbl.includes('Fuerte')?'Fuerte':lbl.includes('SPIN')?'SPIN':'BBVA')?col+'22':'#f8faff',border:`1px solid ${f.cuenta.includes(lbl.includes('Fuerte')?'Fuerte':lbl.includes('SPIN')?'SPIN':'BBVA')?col:'#e5e7eb'}`}}>
              <div style={{fontSize:10,color:'#6b7280',marginBottom:2}}>{lbl}</div>
              <div style={{fontSize:14,fontWeight:700,color:col}}>{fMXN(val)}</div>
            </div>
          ))}
        </div>

        <div style={{marginBottom:14}}><Lbl req>Concepto</Lbl><input value={f.concepto} onChange={e=>set('concepto',e.target.value)} placeholder="Ej: Pago electricidad, Compra detergentes…" style={inp('concepto')}/><Err msg={errs.concepto}/></div>
        <Row2>
          <Col><Lbl req>Categoría</Lbl><select value={f.categoria} onChange={e=>set('categoria',e.target.value)} style={inp('categoria')}><option value="">— Seleccionar —</option>{allCats.map(c=><option key={c}>{c}</option>)}</select><Err msg={errs.categoria}/></Col>
          <Col><Lbl>Subcategoría</Lbl><select value={f.subcategoria} onChange={e=>set('subcategoria',e.target.value)} style={inp('subcategoria')}><option value="">— Seleccionar —</option>{allSubcats.map(s=><option key={s}>{s}</option>)}</select></Col>
        </Row2>

        {/* Si es inventario — seleccionar producto */}
        {esInventario&&(
          <div style={{background:'#f0fdf4',border:'1px solid #86efac',borderRadius:10,padding:'14px 16px',marginBottom:14}}>
            <div style={{fontSize:12,fontWeight:700,color:'#14532d',marginBottom:10}}>📦 Producto que se registra en inventario</div>
            <div style={{marginBottom:10}}><Lbl req>Producto</Lbl>
              <select value={f.producto} onChange={e=>set('producto',e.target.value)} style={inp('producto')}>
                <option value="">— Seleccionar producto existente —</option>
                {prods.map(p=><option key={p}>{p}</option>)}
              </select><Err msg={errs.producto}/>
            </div>
            {selProd&&<div style={{padding:'8px 12px',borderRadius:7,background:'#dcfce7',fontSize:12,color:'#14532d',marginBottom:10}}>
              Stock actual: <strong>{selProd['Cantidad Actual']} {selProd.Unidad}</strong> · Mín: {selProd['Stock Mínimo']} · Máx: {selProd['Stock Máximo']}
            </div>}
            <Row2>
              <Col><Lbl req>Cantidad a ingresar</Lbl><input type="number" min="1" value={f.cantidad} onChange={e=>set('cantidad',e.target.value)} style={inp('cantidad')}/><Err msg={errs.cantidad}/></Col>
              <Col><Lbl>Costo unitario ($)</Lbl><input type="number" min="0" step="0.01" value={f.costoUnitario} onChange={e=>set('costoUnitario',e.target.value)} placeholder="Se calcula del total" style={inp('costoUnitario')}/></Col>
            </Row2>
          </div>
        )}

        <Row2>
          <Col>
            <Lbl req>Cuenta de salida</Lbl>
            <select value={f.cuenta} onChange={e=>set('cuenta',e.target.value)} style={inp('cuenta')}>
              {['Efectivo (Caja Fuerte)','SPIN','BBVA'].map(c=><option key={c}>{c}</option>)}
            </select>
            <div style={{fontSize:11,color:'#6b7280',marginTop:3}}>Disponible: <strong>{fMXN(saldoActual)}</strong></div>
          </Col>
          <Col><Lbl req>Monto total ($)</Lbl><input type="number" min="0" step="0.01" value={f.monto} onChange={e=>set('monto',e.target.value)} style={inp('monto')}/><Err msg={errs.monto}/></Col>
        </Row2>

        <div style={{marginBottom:14}}><Lbl req>Responsable</Lbl><input value={f.responsable} onChange={e=>set('responsable',e.target.value)} placeholder="Nombre de la gerente" style={inp('responsable')}/><Err msg={errs.responsable}/></div>
        <div style={{marginBottom:20}}><Lbl>Notas</Lbl><textarea value={f.notas} onChange={e=>set('notas',e.target.value)} rows={2} style={{padding:'9px 13px',borderRadius:8,fontSize:13,width:'100%',border:'1.5px solid #d1d5db',background:'#fff',resize:'vertical'}}/></div>

        {costoT>0&&f.concepto&&(
          <div style={{background:'#fffbeb',border:'1px solid #fcd34d',borderRadius:9,padding:'10px 14px',marginBottom:14,fontSize:12,color:'#78350f'}}>
            Salida de <strong>{fMXN(costoT)}</strong> desde <strong>{f.cuenta}</strong> · {f.categoria}{f.subcategoria&&' / '+f.subcategoria}
            {esInventario&&f.producto&&<span> → entrada de {f.cantidad||'?'} uds. de <strong>{f.producto}</strong></span>}
          </div>
        )}

        <div style={{display:'flex',gap:12}}>
          <Btn onClick={()=>{if(validate())onSave(f);}} disabled={loading} color="#b07d4a" style={{flex:1,padding:13,fontSize:14}}>{loading?'⌛ Guardando…':'✅ Registrar Gasto'}</Btn>
          <BtnSec onClick={()=>{setF(EMPTY);setErrs({});}}>🔄 Limpiar</BtnSec>
        </div>
      </Card>
    </div>
  );
}

/* ── Comisiones (vista Gerencia — incluye su propia comisión) ── */
function TesoreraComisiones({data,personal,quincenasPagadas,onCerrar}){
  const cierres=useMemo(()=>(data?.cierres||[]).sort((a,b)=>a.Fecha.localeCompare(b.Fecha)),[data]);
  const movTes=data?.movTesoreria||[];

  // Quincena activa
  const hoy=new Date();
  const dia=hoy.getDate();
  const mesAct=hoy.getFullYear()+'-'+String(hoy.getMonth()+1).padStart(2,'0');
  const qStart=dia<=15?`${mesAct}-01`:`${mesAct}-${String(dia<=15?1:16).padStart(2,'0')}`;
  const qEnd=dia<=15?`${mesAct}-15`:`${mesAct}-${String(new Date(hoy.getFullYear(),hoy.getMonth()+1,0).getDate()).padStart(2,'0')}`;
  const qLabel=dia<=15?`1 – 15 de ${hoy.toLocaleDateString('es-MX',{month:'long'})}`:`16 – ${new Date(hoy.getFullYear(),hoy.getMonth()+1,0).getDate()} de ${hoy.toLocaleDateString('es-MX',{month:'long'})}`;

  // Last quincena closed date
  const lastCierre=quincenasPagadas.length>0?quincenasPagadas[quincenasPagadas.length-1].fecha:null;
  const filtStart=lastCierre&&lastCierre>qStart?lastCierre:qStart;

  const cierresQ=useMemo(()=>cierres.filter(c=>c.Fecha>=filtStart&&c.Fecha<=qEnd),[cierres,filtStart,qEnd]);

  // Totals
  const totVentaQ=cierresQ.reduce((s,c)=>s+Number(c.TotalVenta||0),0);

  // Gastos (excluye Nómina)
  const gastosQ=movTes.filter(m=>m.Fecha>=filtStart&&m.Fecha<=qEnd&&m.Categoría!=='Nómina').reduce((s,m)=>s+Number(m.Monto||0),0);

  // All commissions
  const comRecepQ=cierresQ.reduce((s,c)=>s+Number(c.Comision||0),0);
  const comDrasQ=cierresQ.reduce((s,c)=>{try{return s+(JSON.parse(c.ComisionesDras||'[]').reduce((a,d)=>a+Number(d.comision||0),0));}catch(e){return s;}},0);
  const comStilQ=cierresQ.reduce((s,c)=>{try{return s+(JSON.parse(c.ComisionesStil||'[]').reduce((a,e)=>a+Number(e.comision||0),0));}catch(e){return s;}},0);
  const totalOtrasComisiones=comRecepQ+comDrasQ+comStilQ;

  // Tesorera commission = (ventas - gastos - otras comisiones) * pct
  const tesObj=personal.find(p=>p.rol==='Gerente');
  const tesPct=(tesObj?.pct||3)/100;
  const balanceTes=totVentaQ-gastosQ-totalOtrasComisiones;
  const comTes=Math.max(0,balanceTes*tesPct);

  // Per person
  const perPersona=useMemo(()=>{
    const map={};
    // Recep
    cierresQ.forEach(c=>{
      const r=c.Recepcionista||'';if(!r)return;
      if(!map[r])map[r]={nombre:r,rol:'Recepcionista',comision:0,base:0};
      map[r].comision+=Number(c.Comision||0);
      map[r].base+=Number(c.TotalVenta||0);
    });
    // Dras
    cierresQ.forEach(c=>{
      try{JSON.parse(c.ComisionesDras||'[]').forEach(d=>{
        if(!map[d.nombre])map[d.nombre]={nombre:d.nombre,rol:'Doctora',comision:0,base:0};
        map[d.nombre].comision+=Number(d.comision||0);
        map[d.nombre].base+=Number(d.total||0);
      });}catch(e){}
    });
    // Estilistas
    cierresQ.forEach(c=>{
      try{JSON.parse(c.ComisionesStil||'[]').forEach(e=>{
        if(!map[e.nombre])map[e.nombre]={nombre:e.nombre,rol:'Estilista',comision:0,base:0};
        map[e.nombre].comision+=Number(e.comision||0);
        map[e.nombre].base+=Number(e.total||0);
      });}catch(e){}
    });
    return Object.values(map).sort((a,b)=>b.comision-a.comision);
  },[cierresQ]);

  const ROL_BG={'Recepcionista':'#ecedf7','Doctora':'#fce7f3','Estilista':'#e1f5ee','Gerente':'#faeeda'};
  const ROL_CL={'Recepcionista':'#3d4275','Doctora':'#9d174d','Estilista':'#0f6e56','Gerente':'#854f0b'};

  return(
    <div style={{display:'flex',flexDirection:'column',gap:18}}>
      {/* Header quincena */}
      <Card style={{padding:'14px 20px'}}>
        <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',flexWrap:'wrap',gap:12}}>
          <div>
            <div style={{fontSize:15,fontWeight:700,color:'#111827'}}>📅 Quincena activa: {qLabel}</div>
            <div style={{fontSize:12,color:'#6b7280',marginTop:2}}>{cierresQ.length} días registrados{lastCierre?` · Última quincena cerrada: ${fDate(lastCierre)}`:''}
            </div>
          </div>
          <Btn onClick={onCerrar} color="#b07d4a" style={{padding:'8px 18px',fontSize:12}}>
            💳 Cerrar quincena y pagar
          </Btn>
        </div>
      </Card>

      {/* KPIs quincena */}
      <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:12}}>
        <KPI icon="💰" label="Venta Quincena"   value={fMXN(totVentaQ)}           sub="total período"              accent="#5b8a6e" bg="#ccfbf1"/>
        <KPI icon="📤" label="Gastos (sin nóm.)" value={fMXN(gastosQ)}             sub="inventario + servicios"     accent="#dc2626" bg="#fee2e2"/>
        <KPI icon="🎯" label="Comisiones Equipo" value={fMXN(totalOtrasComisiones)} sub="recep + dras + estilistas"  accent="#656b9c" bg="#ecedf7"/>
        <KPI icon="💼" label="Balance Tesorera"  value={fMXN(balanceTes)}          sub={`× ${tesObj?.pct||3}% = ${fMXN(comTes)}`} accent="#b07d4a" bg="#faeeda"/>
      </div>

      {/* Tabla unificada — Opción B */}
      <Card>
        <STitle icon="📊">Comisiones por Persona — Quincena</STitle>
        {/* KPIs por categoría */}
        <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:10,marginBottom:16}}>
          {[
            ['Recepcionistas', comRecepQ, '#ecedf7','#3d4275'],
            ['Doctoras',       comDrasQ,  '#fce7f3','#9d174d'],
            ['Estilistas',     comStilQ,  '#e1f5ee','#0f6e56'],
            ['Gerente',        comTes,    '#faeeda','#854f0b'],
          ].map(([lbl,val,bg,cl])=>(
            <div key={lbl} style={{background:bg,borderRadius:9,padding:'10px 14px',textAlign:'center'}}>
              <div style={{fontSize:11,color:cl,marginBottom:3}}>{lbl}</div>
              <div style={{fontSize:16,fontWeight:700,color:cl}}>{fMXN(val)}</div>
            </div>
          ))}
        </div>
        {/* Tabla detalle */}
        <div style={{display:'flex',flexDirection:'column',gap:7}}>
          {perPersona.map((p,i)=>{
            const pObj=personal.find(x=>x.nombre===p.nombre);
            return(
              <div key={p.nombre} style={{display:'flex',alignItems:'center',gap:12,padding:'10px 14px',borderRadius:9,background:ROL_BG[p.rol]||'#f8faff',border:`1px solid rgba(0,0,0,.06)`}}>
                <div style={{width:30,height:30,borderRadius:'50%',background:ROL_CL[p.rol]||'#656b9c',color:'#fff',display:'flex',alignItems:'center',justifyContent:'center',fontSize:12,fontWeight:700,flexShrink:0}}>
                  {p.nombre.charAt(0).toUpperCase()}
                </div>
                <div style={{flex:1}}>
                  <div style={{fontSize:13,fontWeight:600,color:'#111827'}}>{p.nombre}</div>
                  <div style={{fontSize:11,color:ROL_CL[p.rol],opacity:.8}}>{p.rol} · base {fMXN(p.base)}</div>
                </div>
                <span style={{fontSize:11,padding:'2px 8px',borderRadius:9999,fontWeight:600,background:'rgba(255,255,255,.6)',color:ROL_CL[p.rol]}}>{pObj?.pct||'?'}%</span>
                <div style={{fontSize:16,fontWeight:700,color:ROL_CL[p.rol]}}>{fMXN(p.comision)}</div>
              </div>
            );
          })}
          {/* Tesorera */}
          {tesObj&&(
            <div style={{display:'flex',alignItems:'center',gap:12,padding:'10px 14px',borderRadius:9,background:'#faeeda',border:'1px solid rgba(180,125,74,.3)'}}>
              <div style={{width:30,height:30,borderRadius:'50%',background:'#b07d4a',color:'#fff',display:'flex',alignItems:'center',justifyContent:'center',fontSize:12,fontWeight:700,flexShrink:0}}>
                {tesObj.nombre.charAt(0).toUpperCase()}
              </div>
              <div style={{flex:1}}>
                <div style={{fontSize:13,fontWeight:600,color:'#111827'}}>{tesObj.nombre}</div>
                <div style={{fontSize:11,color:'#854f0b',opacity:.8}}>Gerente · Balance neto {fMXN(balanceTes)}</div>
              </div>
              <span style={{fontSize:11,padding:'2px 8px',borderRadius:9999,fontWeight:600,background:'rgba(255,255,255,.6)',color:'#854f0b'}}>{tesObj.pct}%</span>
              <div style={{fontSize:16,fontWeight:700,color:'#854f0b'}}>{fMXN(comTes)}</div>
            </div>
          )}
          <div style={{display:'flex',justifyContent:'space-between',padding:'10px 16px',borderRadius:8,background:'#3d4275',color:'#fff',marginTop:4}}>
            <span style={{fontSize:13,fontWeight:600}}>Total comisiones quincena</span>
            <span style={{fontSize:16,fontWeight:700}}>{fMXN(totalOtrasComisiones+comTes)}</span>
          </div>
        </div>
      </Card>

      {quincenasPagadas.length>0&&(
        <Card>
          <STitle icon="📋">Historial de Quincenas Pagadas</STitle>
          {quincenasPagadas.map((q,i)=>(
            <div key={i} style={{display:'flex',justifyContent:'space-between',padding:'7px 12px',borderRadius:7,background:'#f8faff',marginBottom:6,fontSize:13}}>
              <span style={{color:'#374151'}}>Quincena #{i+1}</span>
              <span style={{color:'#6b7280'}}>Cerrada el {fDate(q.fecha)}</span>
              <span style={{color:'#16a34a',fontWeight:600}}>✅ Pagada</span>
            </div>
          ))}
        </Card>
      )}
    </div>
  );
}

/* ── Historial Gerencia ── */
function TesoreraHistorial({data}){
  const movs=(data?.movTesoreria||[]).sort((a,b)=>(`${b.Fecha}${b.Hora}`).localeCompare(`${a.Fecha}${a.Hora}`));
  const total=movs.reduce((s,m)=>s+Number(m.Monto||0),0);
  return(
    <Card style={{padding:0,overflow:'hidden'}}>
      <div style={{padding:'14px 18px',borderBottom:`1px solid ${B}`,display:'flex',justifyContent:'space-between',alignItems:'center'}}>
        <span style={{fontSize:14,fontWeight:700}}>📋 Historial de Gastos — Tesorería</span>
        <span style={{fontSize:13,fontWeight:700,color:'#dc2626'}}>Total: {fMXN(total)}</span>
      </div>
      <div style={{overflowX:'auto'}}>
        <table style={{width:'100%',borderCollapse:'collapse',fontSize:12}}>
          <thead><tr>{['Fecha','Concepto','Categoría','Subcategoría','Monto','Cuenta','Responsable'].map(h=><th key={h} style={{padding:'9px 12px',fontSize:11,fontWeight:700,color:'#fff',background:'#b07d4a',textAlign:'left',whiteSpace:'nowrap'}}>{h}</th>)}</tr></thead>
          <tbody>
            {movs.map((m,i)=>(
              <tr key={i} style={{background:i%2?'#fffbeb':'#fff',borderTop:`1px solid ${B}`}}>
                <td style={{padding:'8px 12px',whiteSpace:'nowrap'}}>{fDate(m.Fecha)}</td>
                <td style={{padding:'8px 12px',fontWeight:500}}>{m.Concepto}</td>
                <td style={{padding:'8px 12px'}}>{m.Categoría}</td>
                <td style={{padding:'8px 12px',color:'#6b7280'}}>{m.Subcategoría||'—'}</td>
                <td style={{padding:'8px 12px',textAlign:'right',fontWeight:700,color:'#dc2626'}}>{fMXN(m.Monto)}</td>
                <td style={{padding:'8px 12px'}}><span style={{padding:'2px 8px',borderRadius:9999,fontSize:11,fontWeight:600,background:'#ecedf7',color:'#3d4275'}}>{m.Cuenta}</span></td>
                <td style={{padding:'8px 12px',color:'#374151'}}>{m.Responsable}</td>
              </tr>
            ))}
            {movs.length===0&&<tr><td colSpan={7} style={{padding:40,textAlign:'center',color:'#9ca3af'}}>Sin gastos registrados</td></tr>}
          </tbody>
        </table>
      </div>
    </Card>
  );
}



/* ── Configuración de Dirección ── */
function DirConfig({personal=[],setPersonal,cuentas=[],setCuentas,cats=[],setCats,subcats=[],setSubcats,ubics=[],setUbics,passwords={},quincenasPagadas=[],metaDia=7000,setMetaDia,passSolicitudes='',setPassSolicitudes}){
  const[nuevaCat,setNuevaCat]=useState('');
  const[nuevaSub,setNuevaSub]=useState('');
  const[nuevaUbic,setNuevaUbic]=useState('');
  const[nuevaCuenta,setNuevaCuenta]=useState('');
  const[editIdx,setEditIdx]=useState(null);
  const[editVal,setEditVal]=useState('');
  const[pForm,setPForm]=useState({nombre:'',rol:'Recepcionista',pct:''});
  const[editPIdx,setEditPIdx]=useState(null);
  const ROL_COLORS={'Recepcionista':'#ecedf7','Doctora':'#fce7f3','Estilista':'#e1f5ee','Gerente':'#faeeda'};
  const ROL_TEXT={'Recepcionista':'#3d4275','Doctora':'#9d174d','Estilista':'#0f6e56','Gerente':'#854f0b'};

  function addCat(){const v=nuevaCat.trim();if(!v||cats.includes(v))return;setCats(c=>[...c,v]);setNuevaCat('');}
  function delCat(i){setCats(c=>c.filter((_,j)=>j!==i));}
  function addSub(){const v=nuevaSub.trim();if(!v||subcats.includes(v))return;setSubcats(c=>[...c,v]);setNuevaSub('');}
  function delSub(i){setSubcats(c=>c.filter((_,j)=>j!==i));}
  function addUbic(){const v=nuevaUbic.trim();if(!v||ubics.includes(v))return;setUbics(c=>[...c,v]);setNuevaUbic('');}
  function delUbic(i){setUbics(c=>c.filter((_,j)=>j!==i));}
  function addCuenta(){const v=nuevaCuenta.trim();if(!v||cuentas.includes(v))return;setCuentas(c=>[...c,v]);setNuevaCuenta('');}
  function delCuenta(i){if(editIdx===i){setEditIdx(null);}setCuentas(c=>c.filter((_,j)=>j!==i));}
  function saveCuenta(){if(!editVal.trim())return;setCuentas(c=>c.map((x,i)=>i===editIdx?editVal.trim():x));setEditIdx(null);}
  function addPersonal(){
    const n=pForm.nombre.trim(),p=Number(pForm.pct);
    if(!n)return;
    var newPersonal;
    if(editPIdx!==null){newPersonal=personal.map((x,i)=>i===editPIdx?{...pForm,nombre:n,pct:p||0}:x);setPersonal(newPersonal);setEditPIdx(null);}
    else{newPersonal=[...personal,{nombre:n,rol:pForm.rol,pct:p||0}];setPersonal(newPersonal);}
    setPForm({nombre:'',rol:'Recepcionista',pct:''});
    api({action:'setPersonal',data:JSON.stringify(newPersonal)}).catch(()=>{});
  }
  function delPersonal(i){
    const newP=personal.filter((_,j)=>j!==i);
    setPersonal(newP);
    api({action:'setPersonal',data:JSON.stringify(newP)}).catch(()=>{});
  }
  function startEditP(i){setPForm({...personal[i],pct:String(personal[i].pct)});setEditPIdx(i);}

  const chip=(txt,onDel,bg,cl)=><span style={{display:'inline-flex',alignItems:'center',gap:5,padding:'3px 10px',borderRadius:9999,background:bg,color:cl,fontSize:12,fontWeight:600}}>{txt}<button onClick={onDel} style={{background:'none',border:'none',cursor:'pointer',color:'#dc2626',fontSize:13,lineHeight:1,padding:0}}>×</button></span>;
  const addRow=(val,setVal,onAdd,ph)=>(
    <div style={{display:'flex',gap:8,marginTop:8}}>
      <input value={val} onChange={e=>setVal(e.target.value)} onKeyDown={e=>e.key==='Enter'&&onAdd()} placeholder={ph} style={{flex:1,padding:'7px 11px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12}}/>
      <Btn onClick={onAdd} style={{padding:'7px 14px',fontSize:12}}>+ Agregar</Btn>
    </div>
  );

  return(
    <div style={{maxWidth:680,display:'flex',flexDirection:'column',gap:16}}>

      {/* Personal con comisiones */}
      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:6}}>👥 Personal con Comisiones</h3>
        <p style={{fontSize:12,color:'#6b7280',marginBottom:12,lineHeight:1.6}}>Define nombre, rol y porcentaje. Quienes no comisionan ponen 0%.</p>
        <div style={{display:'flex',flexDirection:'column',gap:6,marginBottom:12}}>
          {personal.map((p,i)=>{
            const bg=ROL_COLORS[p.rol]||'#f3f4f6';
            const cl=ROL_TEXT[p.rol]||'#374151';
            return(
              <div key={i} style={{display:'flex',alignItems:'center',gap:10,padding:'8px 12px',borderRadius:8,background:bg,border:'1px solid rgba(0,0,0,.06)'}}>
                <div style={{flex:1}}>
                  <span style={{fontSize:13,fontWeight:600,color:cl}}>{p.nombre}</span>
                  <span style={{fontSize:11,color:cl,opacity:.7,marginLeft:8}}>{p.rol}</span>
                </div>
                <span style={{fontSize:13,fontWeight:700,color:cl}}>{p.pct}%</span>
                <button onClick={()=>startEditP(i)} style={{background:'none',border:'none',cursor:'pointer',color:'#656b9c',fontSize:13}}>✏️</button>
                <button onClick={()=>delPersonal(i)} style={{background:'none',border:'none',cursor:'pointer',color:'#dc2626',fontSize:15,lineHeight:1}}>×</button>
              </div>
            );
          })}
        </div>
        <div style={{background:'#f8f8fc',borderRadius:9,padding:'12px 14px',border:'1px solid #dddde8'}}>
          <div style={{fontSize:11,fontWeight:700,color:'#656b9c',marginBottom:9}}>{editPIdx!==null?'✏️ Editando':'➕ Agregar'}</div>
          <div style={{display:'grid',gridTemplateColumns:'1fr 1fr auto auto',gap:8,alignItems:'flex-end'}}>
            <div><label style={{fontSize:11,color:'#374151',display:'block',marginBottom:3}}>Nombre</label><input value={pForm.nombre} onChange={e=>setPForm(f=>({...f,nombre:e.target.value}))} style={{padding:'7px 10px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12,width:'100%'}}/></div>
            <div><label style={{fontSize:11,color:'#374151',display:'block',marginBottom:3}}>Rol</label><select value={pForm.rol} onChange={e=>setPForm(f=>({...f,rol:e.target.value}))} style={{padding:'7px 10px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12,width:'100%',background:'#fff'}}>{['Recepcionista','Doctora','Estilista','Gerente'].map(r=><option key={r}>{r}</option>)}</select></div>
            <div><label style={{fontSize:11,color:'#374151',display:'block',marginBottom:3}}>%</label><input type="number" min="0" max="100" step="0.5" value={pForm.pct} onChange={e=>setPForm(f=>({...f,pct:e.target.value}))} style={{padding:'7px 9px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12,width:64}}/></div>
            <div style={{display:'flex',gap:5}}>
              <Btn onClick={addPersonal} style={{padding:'7px 11px',fontSize:12}}>{editPIdx!==null?'✓':'+'}</Btn>
              {editPIdx!==null&&<BtnSec onClick={()=>{setEditPIdx(null);setPForm({nombre:'',rol:'Recepcionista',pct:''});}} style={{padding:'7px 9px',fontSize:12}}>✕</BtnSec>}
            </div>
          </div>
        </div>
      </Card>

      {/* Cuentas */}
      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:12}}>🏦 Cuentas y Cajas</h3>
        <div style={{display:'flex',flexDirection:'column',gap:7,marginBottom:8}}>
          {cuentas.map((c,i)=>(
            <div key={i} style={{display:'flex',alignItems:'center',gap:10,padding:'8px 12px',borderRadius:8,background:'#f8f8fc',border:`1px solid ${B}`}}>
              {editIdx===i?<><input value={editVal} onChange={e=>setEditVal(e.target.value)} onKeyDown={e=>e.key==='Enter'&&saveCuenta()} style={{flex:1,padding:'5px 10px',borderRadius:6,border:'1.5px solid #2563eb',fontSize:12}} autoFocus/><Btn onClick={saveCuenta} color="#16a34a" style={{padding:'5px 11px',fontSize:11}}>✓</Btn><BtnSec onClick={()=>setEditIdx(null)} style={{padding:'5px 9px',fontSize:11}}>✕</BtnSec></>:<><span style={{flex:1,fontSize:13,fontWeight:500}}>🏦 {c}</span><button onClick={()=>{setEditIdx(i);setEditVal(c);}} style={{background:'none',border:'none',cursor:'pointer',color:'#656b9c',fontSize:12}}>✏️</button><button onClick={()=>delCuenta(i)} style={{background:'none',border:'none',cursor:'pointer',color:'#dc2626',fontSize:14}}>×</button></>}
            </div>
          ))}
        </div>
        {addRow(nuevaCuenta,setNuevaCuenta,addCuenta,'Nueva cuenta o caja…')}
      </Card>

      {/* Categorías */}
      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:10}}>📂 Categorías</h3>
        <div style={{display:'flex',flexWrap:'wrap',gap:7,marginBottom:8}}>{cats.map((c,i)=>chip(c,()=>delCat(i),'#dbeafe','#1e3a5f'))}</div>
        {addRow(nuevaCat,setNuevaCat,addCat,'Nueva categoría…')}
      </Card>

      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:10}}>🏷️ Subcategorías</h3>
        <div style={{display:'flex',flexWrap:'wrap',gap:7,marginBottom:8}}>{subcats.map((s,i)=>chip(s,()=>delSub(i),'#dcfce7','#14532d'))}</div>
        {addRow(nuevaSub,setNuevaSub,addSub,'Nueva subcategoría…')}
      </Card>

      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:10}}>📍 Ubicaciones</h3>
        <div style={{display:'flex',flexWrap:'wrap',gap:7,marginBottom:8}}>{ubics.map((u,i)=>chip(u,()=>delUbic(i),'#fef9c3','#713f12'))}</div>
        {addRow(nuevaUbic,setNuevaUbic,addUbic,'Nueva ubicación…')}
      </Card>

      {/* Meta diaria */}
      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:6}}>🎯 Meta de Venta Diaria</h3>
        <p style={{fontSize:12,color:'#6b7280',marginBottom:12,lineHeight:1.6}}>
          La recepcionista ve su progreso hacia esta meta al registrar el corte del día.
        </p>
        <div style={{display:'flex',gap:10,alignItems:'center'}}>
          <span style={{fontSize:13,color:'#374151'}}>$</span>
          <input type="number" min="0" step="100" value={metaDia}
            onChange={function(e){if(setMetaDia)setMetaDia(Number(e.target.value)||0);}}
            style={{padding:'9px 13px',borderRadius:8,fontSize:16,fontWeight:700,
              width:160,border:'1.5px solid #d1d5db',background:'#fff'}}/>
          <span style={{fontSize:12,color:'#6b7280'}}>por día</span>
        </div>
      </Card>

      {/* Contraseñas */}
      <Card>
        <h3 style={{fontSize:15,fontWeight:700,marginBottom:10}}>🔑 Contraseñas de Módulos</h3>
        <p style={{fontSize:12,color:'#6b7280',lineHeight:1.6,marginBottom:12}}>Configura en la hoja <strong>Config</strong> de Google Sheets con las claves: <code>pass_cajera</code>, <code>pass_tesorera</code>, <code>pass_cajaMayor</code></p>
        <div style={{background:'#f8faff',borderRadius:8,padding:'12px 14px',fontSize:12,lineHeight:2}}>
          🧾 Recepción: <code>{passwords.cajera||'sin contraseña'}</code><br/>
          🏢 Gerencia: <code>{passwords.tesorera||'sin contraseña'}</code><br/>
          📋 Dirección: <code>{passwords.cajaMayor||'sin contraseña'}</code><br/>
          📬 Solicitudes: <code>{passwords.solicitudes||'sin contraseña'}</code>
        </div>
        <div style={{marginTop:12}}>
          <label style={{fontSize:12,fontWeight:700,color:'#374151',display:'block',marginBottom:4}}>Contraseña de Solicitudes del Equipo</label>
          <div style={{display:'flex',gap:8}}>
            <input value={passSolicitudes} onChange={function(e){if(setPassSolicitudes)setPassSolicitudes(e.target.value);}}
              placeholder="contraseña para el equipo…"
              style={{flex:1,padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13}}/>
          </div>
          <p style={{fontSize:11,color:'#6b7280',marginTop:4}}>Esta contraseña la usan todos los empleados para acceder a Solicitudes.</p>
        </div>
      </Card>

      <Card style={{background:'#fffbeb',border:'1px solid #d97706',padding:'14px 18px'}}>
        <p style={{fontSize:12,color:'#78350f',lineHeight:1.7}}><strong>URL del Script:</strong><br/><code style={{fontSize:10,wordBreak:'break-all'}}>{SCRIPT_URL}</code></p>
      </Card>
    </div>
  );
}

/* ═══════════════════════════════════════════
   MÓDULO CAJA MAYOR
═══════════════════════════════════════════ */
function ModuloCajaMayor({onLogout,personal=[],setPersonal,quincenasPagadas=[],setQuincenasPagadas,cuentas=[],setCuentas,cats=[],setCats,subcats=[],setSubcats,ubics=[],setUbics,passwords={},metaDia=7000,setMetaDia,passSolicitudes='',setPassSolicitudes,rhData={},asistencia={}}){
  const[view,setView]=useState('dashboard');
  const[data,setData]=useState(null);
  const[loading,setLoading]=useState(false);
  const[toast,setToast]=useState(null);
  const[updated,setUpdated]=useState(new Date());
  function notify(msg,type='info'){setToast({message:msg,type});setTimeout(()=>setToast(null),4500);}
  const load=useCallback(async()=>{setLoading(true);try{const d=await api({action:'getCajaMayor'});setData(d);setUpdated(new Date());}catch(e){notify('Error: '+e.message,'error');}finally{setLoading(false);};},[]);
  useEffect(()=>{load();},[]);
  const NAV=[{id:'dashboard',icon:'📊',label:'Resumen General'},{id:'gerencia',icon:'🏢',label:'Vista Gerencia'},{id:'salida',icon:'🔽',label:'Registrar Gasto'},{id:'historial',icon:'📋',label:'Historial'},{id:'config',icon:'⚙️',label:'Configuración'}];
  return(<>
    <Shell modulo="direccion" onLogout={onLogout} nav={NAV} activeView={view} setView={setView} updated={updated} onRefresh={load} loading={loading}>
      {view==='dashboard'&&<CajaMayorDashboard data={data} personal={personal} rhData={rhData} asistencia={asistencia}/>}
      {view==='gerencia' &&<TesoreraView data={data?.tesoreria}/>}
      {view==='salida'   &&<CajaMayorSalida onSave={async f=>{setLoading(true);try{const d=await api({action:'registrarSalidaCM',...f});setData(d);notify('Salida registrada','success');setView('dashboard');}catch(e){notify('Error: '+e.message,'error');}finally{setLoading(false);}}} loading={loading}/>}
      {view==='historial'&&<CajaMayorHistorial data={data}/>}
      {view==='config'   &&<DirConfig personal={personal} setPersonal={setPersonal} cuentas={cuentas} setCuentas={setCuentas} cats={cats} setCats={setCats} subcats={subcats} setSubcats={setSubcats} ubics={ubics} setUbics={setUbics} passwords={passwords} quincenasPagadas={quincenasPagadas} metaDia={metaDia} setMetaDia={setMetaDia} passSolicitudes={passSolicitudes} setPassSolicitudes={setPassSolicitudes}/>}
    </Shell>
    <Toast t={toast} close={()=>setToast(null)}/>
  </>);
}

// alias para reutilizar
function TesoreraView({data}){
  const r=data?.resumen||{};
  const ventas=data?.cajera?.ventas||[];
  const totalVentas=ventas.reduce((s,v)=>s+Number(v.TotalVenta||0),0);
  return(
    <div style={{display:'flex',flexDirection:'column',gap:18}}>
      <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:12}}>
