/* ── Vista de Solicitudes en Gerencia ── */
function GerenciaSolicitudes({solicitudes,setSolicitudes,inv,onTransferir}){
  const[tab,setTab]=useState('pendientes');

  function aprobar(sol){
    // If producto with known id → transfer from almacen to piso
    if(sol.tipo==='producto'&&sol.productoId&&sol.cantidad){
      onTransferir(sol.productoId,sol.producto,Number(sol.cantidad));
    }
    setSolicitudes(function(prev){return prev.map(function(s){
      return s.id===sol.id?Object.assign({},s,{estado:'aprobada',resueltaEn:localDateStr()}):s;
    });});
  }

  function rechazar(id){
    setSolicitudes(function(prev){return prev.map(function(s){
      return s.id===id?Object.assign({},s,{estado:'rechazada',resueltaEn:localDateStr()}):s;
    });});
  }

  function visto(id){
    setSolicitudes(function(prev){return prev.map(function(s){
      return s.id===id?Object.assign({},s,{estado:'visto',resueltaEn:localDateStr()}):s;
    });});
  }

  var pendientes=solicitudes.filter(function(s){return s.estado==='pendiente';}).reverse();
  var resueltas=solicitudes.filter(function(s){return s.estado!=='pendiente';}).reverse();

  var tipoColor={producto:'#0369a1',descanso:'#5b8a6e',otro:'#7c6ab5'};
  var tipoIcon={producto:'📦',descanso:'🌴',otro:'💬'};
  var estadoStyle={
    aprobada: {bg:'#dcfce7',color:'#14532d',label:'✅ Aprobada'},
    rechazada:{bg:'#fee2e2',color:'#7f1d1d',label:'❌ Rechazada'},
    visto:    {bg:'#f3f4f6',color:'#374151',label:'👁 Visto'},
  };

  function SolCard({sol,actions}){
    var tc=tipoColor[sol.tipo]||'#656b9c';
    var ti=tipoIcon[sol.tipo]||'💬';
    return(
      <div style={{background:'#fff',borderRadius:12,padding:'16px 18px',border:'1px solid '+B,boxShadow:'0 1px 4px rgba(0,0,0,.06)'}}>
        <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:10}}>
          <div style={{display:'flex',gap:10,alignItems:'center'}}>
            <span style={{fontSize:20}}>{ti}</span>
            <div>
              <div style={{fontSize:13,fontWeight:700,color:'#111827'}}>{sol.solicitante}</div>
              <div style={{fontSize:11,color:'#6b7280'}}>{fDate(sol.fecha)} {sol.hora}</div>
            </div>
          </div>
          <span style={{padding:'3px 10px',borderRadius:9999,fontSize:11,fontWeight:600,background:tc+'18',color:tc}}>
            {sol.tipo==='producto'?'Producto':sol.tipo==='descanso'?'Descanso':'Aviso'}
          </span>
        </div>
        {sol.tipo==='producto'&&sol.producto&&(
          <div style={{background:'#eff6ff',borderRadius:8,padding:'8px 12px',marginBottom:10,fontSize:13}}>
            <strong>{sol.producto}</strong>
            {sol.cantidad>0&&<span style={{color:'#0369a1',marginLeft:8}}>× {sol.cantidad}</span>}
            {sol.productoId&&<span style={{fontSize:10,color:'#6b7280',marginLeft:8}}>✓ en inventario</span>}
          </div>
        )}
        {sol.mensaje&&<div style={{fontSize:12,color:'#374151',background:'#f8faff',padding:'8px 12px',borderRadius:8,marginBottom:10,lineHeight:1.6}}>{sol.mensaje}</div>}
        {actions&&(
          <div style={{display:'flex',gap:8}}>
            {sol.tipo==='producto'&&<Btn onClick={function(){aprobar(sol);}} color="#16a34a" style={{flex:1,padding:'7px',fontSize:12}}>✅ Aprobar{sol.productoId?' y transferir':''}</Btn>}
            {sol.tipo!=='producto'&&<Btn onClick={function(){visto(sol.id);}} color="#656b9c" style={{flex:1,padding:'7px',fontSize:12}}>👁 Marcar visto</Btn>}
            <button onClick={function(){rechazar(sol.id);}} style={{flex:1,padding:'7px',borderRadius:7,border:'1px solid #fecaca',background:'#fff',color:'#dc2626',fontSize:12,fontWeight:600,cursor:'pointer'}}>❌ Rechazar</button>
          </div>
        )}
        {!actions&&estadoStyle[sol.estado]&&(
          <span style={{padding:'3px 10px',borderRadius:9999,fontSize:11,fontWeight:600,background:estadoStyle[sol.estado].bg,color:estadoStyle[sol.estado].color}}>
            {estadoStyle[sol.estado].label}
          </span>
        )}
      </div>
    );
  }

  return(
    <div style={{display:'flex',flexDirection:'column',gap:16}}>
      {/* Tabs */}
      <Card style={{padding:'10px 14px'}}>
        <div style={{display:'flex',gap:8}}>
          {[['pendientes','⏳ Pendientes ('+pendientes.length+')'],['resueltas','✅ Resueltas ('+resueltas.length+')']].map(function(item){
            return(
              <button key={item[0]} onClick={function(){setTab(item[0]);}}
                style={{padding:'7px 16px',borderRadius:8,border:'none',cursor:'pointer',fontSize:13,fontWeight:tab===item[0]?700:400,
                  background:tab===item[0]?'#0369a1':'#f1f5f9',color:tab===item[0]?'#fff':'#374151'}}>
                {item[1]}
              </button>
            );
          })}
        </div>
      </Card>

      {/* Pendientes */}
      {tab==='pendientes'&&(
        pendientes.length===0?(
          <Card style={{textAlign:'center',padding:40}}>
            <div style={{fontSize:40,marginBottom:8}}>🎉</div>
            <div style={{fontSize:15,fontWeight:600,color:'#374151'}}>Sin solicitudes pendientes</div>
            <div style={{fontSize:12,color:'#6b7280',marginTop:4}}>Todo al día por ahora.</div>
          </Card>
        ):(
          <div style={{display:'flex',flexDirection:'column',gap:12}}>
            {pendientes.map(function(sol){return <SolCard key={sol.id} sol={sol} actions={true}/>;  })}
          </div>
        )
      )}

      {/* Resueltas */}
      {tab==='resueltas'&&(
        resueltas.length===0?(
          <Card style={{textAlign:'center',padding:40,color:'#9ca3af'}}>Sin solicitudes resueltas aún.</Card>
        ):(
          <div style={{display:'flex',flexDirection:'column',gap:10}}>
            {resueltas.map(function(sol){return <SolCard key={sol.id} sol={sol} actions={false}/>;  })}
          </div>
        )
      )}
    </div>
  );
}


/* ═══════════════════════════════════════════
   RECURSOS HUMANOS
═══════════════════════════════════════════ */
function RHModule({personal=[],asistencia={},setAsistencia,onSetAsistencia,rhData={},setRhData,onSetRhData,quincenasPagadas=[],asuetos={},setAsuetos,onSetAsueto,onDelAsueto}){
  const[tab,setTab]=useState('asistencia');
  const[selPersona,setSelPersona]=useState('');
  const[selFecha,setSelFecha]=useState(localDateStr());
  const[editando,setEditando]=useState(null); // nombre being edited in profiles

  var DIAS_SEM=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  var ESTADOS=[
    {id:'tiempo',       icon:'✅', label:'A tiempo',     color:'#16a34a', bg:'#dcfce7', desc:''},
    {id:'retardo',      icon:'🕐', label:'Retardo',       color:'#d97706', bg:'#fef9c3', desc:'-1/3 día'},
    {id:'retardo_grave',icon:'⚠️', label:'Ret. grave',   color:'#ea580c', bg:'#fff7ed', desc:'-½ día'},
    {id:'falta',        icon:'❌', label:'Falta',         color:'#dc2626', bg:'#fee2e2', desc:'-1 día'},
  ];

  // ── Helpers ──
  function setAst(nombre,fecha,val){
    var key=nombre+'_'+fecha;
    setAsistencia(function(prev){
      var n=Object.assign({},prev);
      if(val===null){delete n[key];}else{n[key]=val;}
      return n;
    });
    api({action:'setRHAsistencia',nombre:nombre,fecha:fecha,estado:val||'null'}).catch(function(){});
  }
  function getAst(nombre,fecha){return asistencia[nombre+'_'+fecha]||null;}

  function getRH(nombre){
    return rhData[nombre]||{tarifa:0,tipoPago:'dia',horario:'',tel:'',pagadoHasta:null,
      horarioEntrada:{Lun:'',Mar:'',Mié:'',Jue:'',Vie:'',Sáb:'',Dom:''},
      horarioSalida: {Lun:'',Mar:'',Mié:'',Jue:'',Vie:'',Sáb:'',Dom:''}};
  }
  function setRH(nombre,data){
    setRhData(function(prev){
      var n=Object.assign({},prev);
      var updated=Object.assign({},getRH(nombre),data);
      n[nombre]=updated;
      // Save to Sheets
      var p={action:'setRHPerfil',nombre:nombre};
      var pe=personal.find(function(x){return x.nombre===nombre;})||{};
      p.rol=pe.rol||'';p.pct=pe.pct||0;
      p.tarifa=updated.tarifa||0;p.tipoPago=updated.tipoPago||'dia';
      p.horario=updated.horario||'';p.tel=updated.tel||'';
      p.pagadoHasta=updated.pagadoHasta||'';
      var dias=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
      var mie='Mie';
      dias.forEach(function(d){
        var dk=d==='Mié'?mie:d;
        p['horarioEntrada_'+dk]=(updated.horarioEntrada||{})[d]||'';
        p['horarioSalida_'+dk]=(updated.horarioSalida||{})[d]||'';
      });
      api(p).catch(function(){});
      return n;
    });
  }

  // ── Cálculo de lo adeudado ──
  function calcDebt(nombre){
    var rh=getRH(nombre);
    var p=personal.find(function(x){return x.nombre===nombre;})||{pct:0};
    var pagadoHasta=rh.pagadoHasta||'1900-01-01';

    // Days worked after last payment
    var keys=Object.keys(asistencia).filter(function(k){
      return k.startsWith(nombre+'_')&&k.slice(nombre.length+1)>pagadoHasta;
    });
    var diasTrabajados=keys.filter(function(k){return asistencia[k]==='tiempo';}).length;
    var retardos=keys.filter(function(k){return asistencia[k]==='retardo';}).length;
    var retGraves=keys.filter(function(k){return asistencia[k]==='retardo_grave';}).length;
    var faltas=keys.filter(function(k){return asistencia[k]==='falta';}).length;

    // Descuentos
    var descRetardos=Math.floor(retardos/3);          // each 3 retardos = 1 day
    var descRetGraves=retGraves*0.5;                   // each ret.grave = 0.5 day
    var descFaltas=faltas;                             // each falta = 1 day
    var totalDescDias=descRetardos+descRetGraves+descFaltas;

    var base=0;
    if(rh.tipoPago==='dia'){
      base=(diasTrabajados-totalDescDias)*Number(rh.tarifa||0);
    } else {
      // Fijo quincenal — compute how many quincenas since pagadoHasta
      base=Number(rh.tarifa||0); // simplified: one quincena pending
    }

    // Comisiones: use quincenasPagadas to find last payment date
    // For now show the total from all records (quincenas handle the reset)
    return{
      diasTrabajados,retardos,retGraves,faltas,
      descRetardos,descRetGraves,descFaltas,totalDescDias,
      base:Math.max(0,base),
      pagadoHasta,
    };
  }

  function marcarPagado(nombre){
    setRH(nombre,{pagadoHasta:localDateStr()});
    // Also save personal with updated pct if needed
    api({action:'setPersonal',data:JSON.stringify(personal)}).catch(function(){});
  }

  // ── Alertas de faltas ──
  function getFaltasUltimos3Meses(nombre){
    var hace3=dAgo(90);
    return Object.keys(asistencia).filter(function(k){
      return k.startsWith(nombre+'_')&&k.slice(nombre.length+1)>=hace3&&asistencia[k]==='falta';
    }).length;
  }

  // ── Build calendar for selected month ──
  var mesActual=selFecha.slice(0,7);
  var[mesCal,setMesCal]=useState(mesActual);
  var partes=mesCal.split('-');
  var totalDiasMes=new Date(Number(partes[0]),Number(partes[1]),0).getDate();
  var diasMes=[];
  for(var d=1;d<=totalDiasMes;d++){
    var f=partes[0]+'-'+partes[1]+'-'+String(d).padStart(2,'0');
    diasMes.push(f);
  }

  var tabStyle=function(active){return{padding:'7px 16px',borderRadius:8,border:'none',cursor:'pointer',fontSize:13,fontWeight:active?700:400,background:active?'#b07d4a':'#f1f5f9',color:active?'#fff':'#374151'};};

  return(
    <div style={{display:'flex',flexDirection:'column',gap:16}}>
      {/* Tabs */}
      <Card style={{padding:'10px 14px'}}>
        <div style={{display:'flex',gap:8,flexWrap:'wrap'}}>
          {[['asistencia','📅 Asistencia'],['deudas','💰 Lo adeudado'],['perfiles','👤 Perfiles'],['asuetos','📆 Asuetos']].map(function(item){return(
            <button key={item[0]} onClick={function(){setTab(item[0]);}} style={tabStyle(tab===item[0])}>{item[1]}</button>
          );})}
        </div>
      </Card>

      {/* ── TAB: ASISTENCIA ── */}
      {tab==='asistencia'&&(
        <div style={{display:'flex',flexDirection:'column',gap:14}}>
          {/* Controles mes */}
          <Card style={{padding:'12px 16px'}}>
            <div style={{display:'flex',gap:10,alignItems:'center',flexWrap:'wrap'}}>
              <span style={{fontSize:13,fontWeight:700}}>📅 Mes:</span>
              <input type="month" value={mesCal} onChange={function(e){setMesCal(e.target.value);}}
                style={{padding:'7px 11px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13}}/>
              <span style={{fontSize:12,color:'#6b7280'}}>{totalDiasMes} días</span>
            </div>
          </Card>

          {/* Tabla de asistencia */}
          <Card style={{padding:0,overflow:'hidden'}}>
            <div style={{overflowX:'auto'}}>
              <table style={{borderCollapse:'collapse',fontSize:12,minWidth:'100%'}}>
                <thead>
                  <tr>
                    <th style={{padding:'10px 14px',background:'#b07d4a',color:'#fff',fontSize:11,fontWeight:700,textAlign:'left',whiteSpace:'nowrap',position:'sticky',left:0,zIndex:1}}>Persona</th>
                    {diasMes.map(function(f){
                      var dn=new Date(f+'T12:00:00').getDay();
                      var esFind=dn===0||dn===6;
                      return(
                        <th key={f} style={{padding:'6px 4px',background:esFind?'#f3f4f6':'#b07d4a',color:esFind?'#9ca3af':'#fff',fontSize:10,fontWeight:700,textAlign:'center',minWidth:32}}>
                          <div>{DIAS_SEM[dn].slice(0,2)}</div>
                          <div>{Number(f.slice(8))}</div>
                        </th>
                      );
                    })}
                  </tr>
                </thead>
                <tbody>
                  {personal.map(function(p,pi){
                    var faltas3m=getFaltasUltimos3Meses(p.nombre);
                    return(
                      <tr key={p.nombre} style={{background:pi%2===0?'#fff':'#fafafa',borderTop:'1px solid #e5e7eb'}}>
                        <td style={{padding:'8px 14px',fontWeight:600,color:'#111827',whiteSpace:'nowrap',position:'sticky',left:0,background:pi%2===0?'#fff':'#fafafa',zIndex:1}}>
                          <div style={{display:'flex',alignItems:'center',gap:6}}>
                            {p.nombre}
                            {faltas3m>3&&<span title="Más de 3 faltas en 3 meses" style={{background:'#dc2626',color:'#fff',borderRadius:9999,fontSize:9,padding:'1px 5px',fontWeight:700}}>⚠️ {faltas3m}F</span>}
                          </div>
                          <div style={{fontSize:10,color:'#9ca3af'}}>{p.rol}</div>
                        </td>
                        {diasMes.map(function(f){
                          var ast=getAst(p.nombre,f);
                          var est=ESTADOS.find(function(e){return e.id===ast;})||null;
                          var isFut=f>todayStr;
                          return(
                            <td key={f} style={{padding:2,textAlign:'center'}}>
                              <select
                                value={ast||''}
                                onChange={function(ev){setAst(p.nombre,f,ev.target.value||null);}}
                                disabled={isFut}
                                title={est?est.label:'Sin marcar'}
                                style={{
                                  width:30,height:26,border:'1px solid #e5e7eb',borderRadius:4,
                                  fontSize:13,cursor:isFut?'not-allowed':'pointer',
                                  background:est?est.bg:'#fff',
                                  color:est?est.color:'#9ca3af',
                                  textAlign:'center',padding:0,
                                  opacity:isFut?0.4:1,
                                }}>
                                <option value="">·</option>
                                {ESTADOS.map(function(e){return <option key={e.id} value={e.id}>{e.icon}</option>;})}
                              </select>
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            {/* Leyenda */}
            <div style={{padding:'10px 14px',borderTop:'1px solid #e5e7eb',display:'flex',gap:14,flexWrap:'wrap'}}>
              {ESTADOS.map(function(e){return(
                <div key={e.id} style={{display:'flex',alignItems:'center',gap:4,fontSize:11}}>
                  <span>{e.icon}</span>
                  <span style={{color:'#374151'}}>{e.label}</span>
                  {e.desc&&<span style={{color:'#dc2626',fontWeight:600}}>{e.desc}</span>}
                </div>
              );})}
              <span style={{fontSize:11,color:'#6b7280'}}>· = No aplica (día libre o sin horario)</span>
            </div>
          </Card>
        </div>
      )}

      {/* ── TAB: LO ADEUDADO ── */}
      {tab==='deudas'&&(
        <div style={{display:'flex',flexDirection:'column',gap:12}}>
          {personal.map(function(p){
            var rh=getRH(p.nombre);
            var debt=calcDebt(p.nombre);
            var faltas3m=getFaltasUltimos3Meses(p.nombre);
            var alerta=faltas3m>3;
            return(
              <Card key={p.nombre} style={{borderLeft:'4px solid '+(alerta?'#dc2626':debt.base>0?'#b07d4a':'#e5e7eb')}}>
                <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',flexWrap:'wrap',gap:12,marginBottom:12}}>
                  <div>
                    <div style={{display:'flex',alignItems:'center',gap:8,marginBottom:2}}>
                      <span style={{fontSize:14,fontWeight:700,color:'#111827'}}>{p.nombre}</span>
                      <span style={{fontSize:11,color:'#6b7280',background:'#f3f4f6',padding:'1px 7px',borderRadius:9999}}>{p.rol}</span>
                      {alerta&&<span style={{fontSize:11,fontWeight:700,color:'#dc2626',background:'#fee2e2',padding:'1px 7px',borderRadius:9999}}>⚠️ {faltas3m} faltas/3 meses</span>}
                    </div>
                    <div style={{fontSize:11,color:'#6b7280'}}>
                      {rh.tipoPago==='dia'?'Por día · $'+Number(rh.tarifa||0).toLocaleString():'Fijo quincenal · $'+Number(rh.tarifa||0).toLocaleString()}
                      {debt.pagadoHasta&&debt.pagadoHasta!=='1900-01-01'&&' · Pagado hasta: '+fDate(debt.pagadoHasta)}
                    </div>
                  </div>
                  <div style={{textAlign:'right'}}>
                    <div style={{fontSize:24,fontWeight:800,color:debt.base>0?'#b07d4a':'#9ca3af'}}>{fMXN(debt.base)}</div>
                    <div style={{fontSize:10,color:'#6b7280'}}>sueldo adeudado</div>
                  </div>
                </div>
                {/* Desglose */}
                <div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:8,marginBottom:12}}>
                  {[
                    ['✅ Días trabajados',debt.diasTrabajados,'#16a34a'],
                    ['🕐 Retardos',debt.retardos+(debt.descRetardos>0?' (-'+debt.descRetardos+'d)':''),'#d97706'],
                    ['⚠️ Ret. graves',debt.retGraves+(debt.descRetGraves>0?' (-'+debt.descRetGraves+'d)':''),'#ea580c'],
                    ['❌ Faltas',debt.faltas+(debt.descFaltas>0?' (-'+debt.descFaltas+'d)':''),'#dc2626'],
                  ].map(function(item){return(
                    <div key={item[0]} style={{textAlign:'center',background:'#f8faff',borderRadius:7,padding:'7px 8px'}}>
                      <div style={{fontSize:10,color:'#6b7280',marginBottom:3}}>{item[0]}</div>
                      <div style={{fontSize:14,fontWeight:700,color:item[2]}}>{item[1]}</div>
                    </div>
                  );})}
                </div>
                <button onClick={function(){if(window.confirm('¿Marcar como pagado a '+p.nombre+'? El conteo se reiniciará desde hoy.')){marcarPagado(p.nombre);}}}
                  style={{padding:'8px 18px',borderRadius:8,border:'none',background:'#16a34a',color:'#fff',fontSize:12,fontWeight:700,cursor:'pointer'}}>
                  💳 Marcar como pagado
                </button>
              </Card>
            );
          })}
        </div>
      )}

      {/* ── TAB: ASUETOS ── */}
      {tab==='asuetos'&&(
        <Card>
          <STitle icon="📆">Calendario de Asuetos y Salidas Tempranas</STitle>
          <CalendarioAsuetos asuetos={asuetos} setAsuetos={setAsuetos} canEdit={true}/>
        </Card>
      )}

      {/* ── TAB: PERFILES ── */}
      {tab==='perfiles'&&(
        <div style={{display:'flex',flexDirection:'column',gap:12}}>
          {personal.map(function(p){
            var rh=getRH(p.nombre);
            var isEdit=editando===p.nombre;
            return(
              <Card key={p.nombre}>
                <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:isEdit?14:0}}>
                  <div>
                    <span style={{fontSize:14,fontWeight:700,color:'#111827'}}>{p.nombre}</span>
                    <span style={{fontSize:11,color:'#6b7280',marginLeft:8}}>{p.rol}</span>
                    {!isEdit&&rh.tarifa>0&&<span style={{fontSize:11,color:'#b07d4a',marginLeft:8}}>{rh.tipoPago==='dia'?'$'+rh.tarifa+'/día':'$'+rh.tarifa+' quincenal'}</span>}
                  </div>
                  <button onClick={function(){setEditando(isEdit?null:p.nombre);}}
                    style={{padding:'5px 12px',borderRadius:7,border:'1px solid #d1d5db',background:isEdit?'#f3f4f6':'#fff',fontSize:12,cursor:'pointer',color:'#374151'}}>
                    {isEdit?'✕ Cerrar':'✏️ Editar'}
                  </button>
                </div>
                {isEdit&&(
                  <div style={{display:'flex',flexDirection:'column',gap:12}}>
                    <Row2>
                      <Col>
                        <Lbl>Tipo de pago</Lbl>
                        <select value={rh.tipoPago||'dia'} onChange={function(e){setRH(p.nombre,{tipoPago:e.target.value});}}
                          style={{padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,width:'100%',background:'#fff'}}>
                          <option value="dia">Por día acumulado</option>
                          <option value="quincenal">Fijo quincenal</option>
                        </select>
                      </Col>
                      <Col>
                        <Lbl>{rh.tipoPago==='quincenal'?'Monto quincenal ($)':'Tarifa por día ($)'}</Lbl>
                        <input type="number" min="0" value={rh.tarifa||''} onChange={function(e){setRH(p.nombre,{tarifa:Number(e.target.value)||0});}}
                          placeholder="0" style={{padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,width:'100%'}}/>
                      </Col>
                    </Row2>
                    <Row2>
                      <Col>
                        <Lbl>Teléfono de emergencia</Lbl>
                        <input value={rh.tel||''} onChange={function(e){setRH(p.nombre,{tel:e.target.value});}}
                          placeholder="55 1234 5678" style={{padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,width:'100%'}}/>
                      </Col>
                      <Col>
                        <Lbl>Notas / Horario general</Lbl>
                        <input value={rh.horario||''} onChange={function(e){setRH(p.nombre,{horario:e.target.value});}}
                          placeholder="Ej: Lun-Vie 9am-6pm" style={{padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,width:'100%'}}/>
                      </Col>
                    </Row2>
                    {/* Horario por día */}
                    <div>
                      <Lbl>Horario de entrada y salida por día</Lbl>
                      <div style={{display:'grid',gridTemplateColumns:'repeat(7,1fr)',gap:6,marginTop:6}}>
                        {['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(function(dia){return(
                          <div key={dia} style={{textAlign:'center'}}>
                            <div style={{fontSize:10,fontWeight:700,color:'#6b7280',marginBottom:4}}>{dia}</div>
                            <input type="time" value={(rh.horarioEntrada||{})[dia]||''} onChange={function(e){var h=Object.assign({},(rh.horarioEntrada||{}));h[dia]=e.target.value;setRH(p.nombre,{horarioEntrada:h});}}
                              style={{width:'100%',padding:'4px 3px',borderRadius:5,border:'1px solid #d1d5db',fontSize:10,marginBottom:3}}/>
                            <input type="time" value={(rh.horarioSalida||{})[dia]||''} onChange={function(e){var h=Object.assign({},(rh.horarioSalida||{}));h[dia]=e.target.value;setRH(p.nombre,{horarioSalida:h});}}
                              style={{width:'100%',padding:'4px 3px',borderRadius:5,border:'1px solid #d1d5db',fontSize:10}}/>
                          </div>
                        );})}
                      </div>
                      <div style={{fontSize:10,color:'#9ca3af',marginTop:4}}>Fila superior: entrada · Fila inferior: salida</div>
                    </div>
                  </div>
                )}
                {!isEdit&&rh.tel&&<div style={{fontSize:11,color:'#6b7280',marginTop:6}}>📞 {rh.tel}{rh.horario&&' · 🕐 '+rh.horario}</div>}
              </Card>
            );
          })}
        </div>
      )}
    </div>
  );
}


/* ═══════════════════════════════════════════
   PIZARRÓN DE NOTAS (postits compartidos)
═══════════════════════════════════════════ */
var COLORES_POSTIT=['#fef9c3','#fce7f3','#dbeafe','#dcfce7','#ede9fe','#ffedd5'];
function Pizarron({notas,setNotas,canEdit,autor}){
  const[nueva,setNueva]=useState('');
  const[mostrar,setMostrar]=useState(true);
  var colIdx=notas.length%COLORES_POSTIT.length;
  function agregar(){
    var txt=nueva.trim();
    if(!txt)return;
    setNotas(function(prev){return[...prev,{id:Date.now(),texto:txt,fecha:localDateStr(),color:COLORES_POSTIT[colIdx],autor:autor||''}];});
    setNueva('');
  }
  function borrar(id){setNotas(function(prev){return prev.filter(function(n){return n.id!==id;});});}
  if(!mostrar&&notas.length===0)return null;
  return(
    <div style={{background:'#fff',borderRadius:12,padding:'16px 18px',boxShadow:'0 2px 8px rgba(101,107,156,.1)',border:'1px solid #dddde8'}}>
      <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:mostrar?14:0}}>
        <div style={{fontSize:14,fontWeight:700,color:'#111827',display:'flex',alignItems:'center',gap:8}}>
          📌 Pizarrón
          {notas.length>0&&<span style={{fontSize:11,background:'#656b9c',color:'#fff',borderRadius:9999,padding:'1px 7px'}}>{notas.length}</span>}
        </div>
        <button onClick={function(){setMostrar(function(m){return !m;});}} style={{background:'none',border:'none',cursor:'pointer',fontSize:12,color:'#9ca3af'}}>
          {mostrar?'▲ Ocultar':'▼ Ver'}
        </button>
      </div>
      {mostrar&&(
        <>
          {notas.length===0&&!canEdit&&(
            <div style={{textAlign:'center',padding:'16px 0',color:'#9ca3af',fontSize:13}}>Sin avisos por el momento.</div>
          )}
          {notas.length>0&&(
            <div style={{display:'flex',flexWrap:'wrap',gap:10,marginBottom:canEdit?12:0}}>
              {notas.map(function(n){return(
                <div key={n.id} style={{background:n.color,borderRadius:8,padding:'10px 12px',minWidth:140,maxWidth:220,
                  boxShadow:'2px 3px 8px rgba(0,0,0,.1)',position:'relative',flex:'0 0 auto'}}>
                  <p style={{fontSize:13,color:'#1f2937',lineHeight:1.5,margin:0,paddingRight:canEdit?18:0,whiteSpace:'pre-wrap'}}>{n.texto}</p>
                  <div style={{fontSize:10,color:'#6b7280',marginTop:8,display:'flex',justifyContent:'space-between'}}>
                    <span>{fDate(n.fecha)}</span>
                    {n.autor&&<span style={{fontWeight:600}}>— {n.autor}</span>}
                  </div>
                  {canEdit&&(
                    <button onClick={function(){borrar(n.id);}}
                      style={{position:'absolute',top:6,right:6,background:'none',border:'none',cursor:'pointer',
                        fontSize:14,color:'rgba(0,0,0,.3)',lineHeight:1,padding:2}}>×</button>
                  )}
                </div>
              );})}
            </div>
          )}
          {canEdit&&(
            <div style={{display:'flex',gap:8}}>
              <textarea value={nueva} onChange={function(e){setNueva(e.target.value);}}
                onKeyDown={function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();agregar();}}}
                placeholder="Escribe un aviso o pendiente… (Enter para agregar)"
                rows={2} style={{flex:1,padding:'8px 12px',borderRadius:8,border:'1.5px solid #d1d5db',fontSize:13,resize:'none',fontFamily:'inherit'}}/>
              <button onClick={agregar}
                style={{padding:'8px 14px',borderRadius:8,border:'none',background:'#656b9c',color:'#fff',
                  fontSize:13,fontWeight:700,cursor:'pointer',alignSelf:'flex-end'}}>
                📌 Agregar
              </button>
            </div>
          )}
        </>
      )}
    </div>
  );
}

/* ═══════════════════════════════════════════
   CALENDARIO DE ASUETOS
═══════════════════════════════════════════ */
function CalendarioAsuetos({asuetos,setAsuetos,canEdit}){
  const[anio,setAnio]=useState(new Date().getFullYear());
  const[selFecha,setSelFecha]=useState('');
  const[form,setForm]=useState({tipo:'asueto',descripcion:''});
  var MESES=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var DIAS_SEM_CORTO=['D','L','M','X','J','V','S'];
  function addAsueto(){
    if(!selFecha||!form.descripcion.trim())return;
    var desc=form.descripcion.trim();
    setAsuetos(function(prev){var n=Object.assign({},prev);n[selFecha]={tipo:form.tipo,descripcion:desc};return n;});
    api({action:'setAsueto',fecha:selFecha,tipo:form.tipo,descripcion:desc}).catch(function(){});
    setSelFecha('');setForm({tipo:'asueto',descripcion:''});
  }
  function delAsueto(f){
    setAsuetos(function(prev){var n=Object.assign({},prev);delete n[f];return n;});
    api({action:'delAsueto',fecha:f}).catch(function(){});
  }
  // Build year grid
  var mesesGrid=[];
  for(var m=0;m<12;m++){
    var dias=[];
    var primerDia=new Date(anio,m,1).getDay();
    var totalDias=new Date(anio,m+1,0).getDate();
    for(var i=0;i<primerDia;i++)dias.push(null);
    for(var d=1;d<=totalDias;d++)dias.push(d);
    mesesGrid.push({mes:m,dias:dias});
  }
  var tipoColor={asueto:'#656b9c',salida_temprana:'#5b8a6e'};
  var tipoBg={asueto:'#ecedf7',salida_temprana:'#dcfce7'};
  return(
    <div style={{display:'flex',flexDirection:'column',gap:16}}>
      {/* Header */}
      <div style={{display:'flex',alignItems:'center',gap:12}}>
        <button onClick={function(){setAnio(function(a){return a-1;});}} style={{padding:'5px 12px',borderRadius:7,border:'1px solid #d1d5db',background:'#fff',cursor:'pointer',fontSize:14}}>‹</button>
        <span style={{fontSize:16,fontWeight:700,color:'#111827',minWidth:60,textAlign:'center'}}>{anio}</span>
        <button onClick={function(){setAnio(function(a){return a+1;});}} style={{padding:'5px 12px',borderRadius:7,border:'1px solid #d1d5db',background:'#fff',cursor:'pointer',fontSize:14}}>›</button>
        <div style={{marginLeft:'auto',display:'flex',gap:10}}>
          <span style={{display:'flex',alignItems:'center',gap:4,fontSize:11}}><span style={{width:10,height:10,background:'#656b9c',borderRadius:2,display:'inline-block'}}/> Día de asueto</span>
          <span style={{display:'flex',alignItems:'center',gap:4,fontSize:11}}><span style={{width:10,height:10,background:'#5b8a6e',borderRadius:2,display:'inline-block'}}/> Salida temprana</span>
        </div>
      </div>
      {/* Grid de meses */}
      <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:14}}>
        {mesesGrid.map(function(mg){return(
          <div key={mg.mes} style={{background:'#fff',borderRadius:10,padding:'10px 12px',border:'1px solid #dddde8'}}>
            <div style={{fontSize:12,fontWeight:700,color:'#374151',marginBottom:6,textAlign:'center'}}>{MESES[mg.mes]}</div>
            <div style={{display:'grid',gridTemplateColumns:'repeat(7,1fr)',gap:1,marginBottom:3}}>
              {DIAS_SEM_CORTO.map(function(d){return <div key={d} style={{fontSize:8,fontWeight:700,color:'#9ca3af',textAlign:'center'}}>{d}</div>;})}
            </div>
            <div style={{display:'grid',gridTemplateColumns:'repeat(7,1fr)',gap:1}}>
              {mg.dias.map(function(d,i){
                if(!d)return <div key={'e'+i}/>;
                var fecha=anio+'-'+String(mg.mes+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
                var ast=asuetos[fecha];
                var dn=new Date(fecha+'T12:00:00').getDay();
                var esFind=dn===0||dn===6;
                return(
                  <div key={d}
                    onClick={function(){if(canEdit)setSelFecha(fecha);}}
                    title={ast?ast.descripcion:''}
                    style={{
                      width:'100%',aspectRatio:'1',borderRadius:3,
                      display:'flex',alignItems:'center',justifyContent:'center',
                      fontSize:9,fontWeight:ast?700:400,
                      background:ast?tipoBg[ast.tipo]:esFind?'#f9fafb':'transparent',
                      color:ast?tipoColor[ast.tipo]:esFind?'#d1d5db':'#374151',
                      cursor:canEdit?'pointer':'default',
                      border:selFecha===fecha?'2px solid #656b9c':'1px solid transparent',
                    }}>
                    {d}
                  </div>
                );
              })}
            </div>
          </div>
        );})}
      </div>
      {/* Agregar asueto */}
      {canEdit&&(
        <div style={{background:'#f8f8fc',borderRadius:10,padding:'14px 16px',border:'1px solid #dddde8'}}>
          <div style={{fontSize:12,fontWeight:700,color:'#656b9c',marginBottom:10}}>{selFecha?'📆 '+fDate(selFecha):'Selecciona un día del calendario para marcarlo'}</div>
          {selFecha&&(
            <div style={{display:'flex',gap:10,alignItems:'flex-end',flexWrap:'wrap'}}>
              <div>
                <label style={{fontSize:11,color:'#374151',display:'block',marginBottom:3}}>Tipo</label>
                <select value={form.tipo} onChange={function(e){setForm(function(f){return Object.assign({},f,{tipo:e.target.value});});}}
                  style={{padding:'7px 10px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12,background:'#fff'}}>
                  <option value="asueto">Día de asueto</option>
                  <option value="salida_temprana">Salida temprana</option>
                </select>
              </div>
              <div style={{flex:1,minWidth:180}}>
                <label style={{fontSize:11,color:'#374151',display:'block',marginBottom:3}}>Descripción</label>
                <input value={form.descripcion} onChange={function(e){setForm(function(f){return Object.assign({},f,{descripcion:e.target.value});});}}
                  placeholder="Ej: Día de la Independencia, Cierre temprano por evento…"
                  style={{padding:'7px 10px',borderRadius:7,border:'1.5px solid #d1d5db',fontSize:12,width:'100%'}}/>
              </div>
              <Btn onClick={addAsueto} style={{padding:'7px 14px',fontSize:12}}>+ Marcar</Btn>
            </div>
          )}
        </div>
      )}
      {/* Lista de asuetos del año */}
      {Object.keys(asuetos).filter(function(f){return f.startsWith(String(anio));}).length>0&&(
        <div>
          <div style={{fontSize:12,fontWeight:700,color:'#374151',marginBottom:8}}>Días marcados en {anio}:</div>
          <div style={{display:'flex',flexDirection:'column',gap:6}}>
            {Object.keys(asuetos).filter(function(f){return f.startsWith(String(anio));}).sort().map(function(f){
              var ast=asuetos[f];
              return(
                <div key={f} style={{display:'flex',alignItems:'center',gap:10,padding:'7px 12px',borderRadius:8,background:tipoBg[ast.tipo],border:'1px solid '+(ast.tipo==='asueto'?'#c7d2fe':'#bbf7d0')}}>
                  <span style={{fontSize:13,fontWeight:700,color:tipoColor[ast.tipo]}}>{fDate(f)}</span>
                  <span style={{fontSize:12,color:'#374151',flex:1}}>{ast.descripcion}</span>
                  <span style={{fontSize:11,color:tipoColor[ast.tipo],fontWeight:600,background:'#fff',padding:'1px 7px',borderRadius:9999}}>{ast.tipo==='asueto'?'Asueto':'Salida temprana'}</span>
                  {canEdit&&<button onClick={function(){delAsueto(f);}} style={{background:'none',border:'none',cursor:'pointer',color:'#dc2626',fontSize:16,lineHeight:1}}>×</button>}
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>
